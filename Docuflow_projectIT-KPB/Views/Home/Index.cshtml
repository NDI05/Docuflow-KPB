@using Microsoft.AspNetCore.Http
@using Docuflow_projectIT_KPB.Models
@using System.Linq

@{
    ViewData["Title"] = "Dashboard";
}

<style>
    .dashboard-container {
        padding: 25px;
        background: #f4f6fb;
        border-radius: 18px;
        min-height: 80vh;
    }

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

        .dashboard-header h3 {
            font-weight: 700;
            color: #1f2d3d;
            margin: 0;
        }

        .dashboard-header p {
            margin: 0;
            font-size: 14px;
            color: #6c757d;
        }

    .stat-card {
        border-radius: 16px;
        border: none;
        padding: 18px;
        background: white;
        box-shadow: 0px 8px 20px rgba(0,0,0,0.08);
        transition: 0.2s ease-in-out;
    }

        .stat-card:hover {
            transform: translateY(-3px);
        }

    .stat-title {
        font-size: 15px;
        font-weight: 600;
        color: #6c757d;
        margin-bottom: 5px;
    }

    .stat-value {
        font-size: 44px;
        font-weight: 800;
        color: #1f2d3d;
        margin: 0;
    }

    .section-title {
        font-weight: 700;
        color: #1f2d3d;
        margin-top: 30px;
        margin-bottom: 15px;
    }

    .jenis-card {
        border-radius: 16px;
        border: none;
        padding: 16px;
        background: #e9ecf5;
        transition: 0.2s ease-in-out;
        height: 100%;
    }

        .jenis-card:hover {
            background: #dfe4f2;
            transform: translateY(-2px);
        }

    .jenis-title {
        font-size: 13px;
        font-weight: 600;
        color: #2c3e50;
        margin-bottom: 10px;
    }

    .jenis-value {
        font-size: 32px;
        font-weight: 800;
        color: #111827;
        margin: 0;
    }

    .audit-card {
        border-radius: 16px;
        background: white;
        padding: 18px;
        box-shadow: 0px 8px 20px rgba(0,0,0,0.08);
    }

    .audit-item {
        padding: 14px 0;
        border-bottom: 1px solid #eceff5;
    }

        .audit-item:last-child {
            border-bottom: none;
        }

    .audit-activity {
        font-size: 16px;
        font-weight: 700;
        color: #1f2d3d;
        margin-bottom: 8px;
    }

    .audit-user {
        font-size: 13px;
        color: #6c757d;
        margin-bottom: 4px;
        padding-left: 10px;
    }

    .audit-count {
        color: #2563eb;
        font-weight: 600;
    }
</style>

<div class="dashboard-container">

    <div class="dashboard-header">
        <div>
            <h3>Beranda</h3>
            <p>
                Selamat Datang,
                <b>@Context.Session.GetString("Nama")</b>
            </p>
        </div>
    </div>

    <div class="row g-4">

        <div class="col-md-6">
            <div class="stat-card">
                <div class="stat-title">
                    Total Surat
                </div>

                <h2 class="stat-value">
                    @ViewBag.TotalSurat
                </h2>
            </div>
        </div>

        <div class="col-md-6">
            <div class="stat-card">
                <div class="stat-title">
                    Total Users
                </div>

                <h2 class="stat-value">
                    @ViewBag.TotalUsers
                </h2>
            </div>
        </div>

    </div>

    <h5 class="section-title">
        Total Surat per Jenis
    </h5>

    <div class="row g-3">

        @foreach (var item in ViewBag.SuratPerJenis)
        {
            <div class="col-lg-3 col-md-4 col-sm-6">

                <div class="jenis-card">

                    <div class="jenis-title">
                        @item.NamaJenis
                    </div>

                    <h3 class="jenis-value">
                        @item.Total
                    </h3>

                </div>

            </div>
        }

    </div>

    @if (Context.Session.GetString("Role") == "Admin")
    {
        <h5 class="section-title">
            Aktivitas Terbaru
        </h5>

        <div class="audit-card">

            @{
                var logs = ViewBag.AktivitasTerbaru as List<AuditLog>;
            }

            @if (logs != null && logs.Any())
            {
                var groupedLogs = logs
                    .GroupBy(x => x.Aktivitas)
                    .OrderByDescending(x => x.Count());

                @foreach (var group in groupedLogs)
                {
                    <div class="audit-item">

                        <div class="audit-activity">
                            @group.Key
                            <span class="audit-count">
                                (@group.Count())
                            </span>
                        </div>

                        @foreach (var item in group.Take(5))
                        {
                            <div class="audit-user">
                                • @item.Username
                                (@item.Waktu.ToString("dd/MM/yyyy HH:mm"))
                            </div>
                        }

                        @if (group.Count() > 5)
                        {
                            <div class="audit-user">
                                + @(group.Count() - 5) aktivitas lainnya
                            </div>
                        }

                    </div>
                }
            }
            else
            {
                <div class="text-muted">
                    Belum ada aktivitas tercatat.
                </div>
            }

        </div>
    }

</div>