@using Docuflow_projectIT_KPB.Models

@{
    ViewData["Title"] = "Beranda";
    // Eyebrow menyebut jenis halaman, sejalan dengan "Arsip" di Berita Acara
    // dan "Administrasi" di Pengguna.
    ViewData["Eyebrow"] = "Ringkasan";
    ViewData["Sub"] = $"Selamat datang, {Context.Session.GetString("Nama")}.";

    var superAdmin = (string)ViewBag.Role == "SuperAdmin";
}

@* Beranda sengaja tanpa tombol aksi di kepala halaman.
   "Buat berita acara" tinggal di halaman Berita Acara, "Tambah pengguna" di
   halaman Pengguna — aksi berada di tempat kerjanya, bukan diulang di
   header setiap halaman. Ajakan yang tersisa di beranda hanya muncul saat
   datanya memang kosong, dan itu memang tugas keadaan kosong. *@

@if (superAdmin)
{
    var logs = ViewBag.AktivitasTerbaru as List<AuditLog>;

    <div class="panel mb-4">
        <div class="panel__body">
            <div class="tally">
                <div class="tally__item">
                    <div class="tally__n">@ViewBag.TotalUsers</div>
                    <div class="tally__l">Pengguna</div>
                </div>
                <div class="tally__item">
                    <div class="tally__n">@ViewBag.TotalAktivitas</div>
                    <div class="tally__l">Aktivitas tercatat</div>
                </div>
                <div class="tally__item">
                    <div class="tally__n">@ViewBag.TotalSurat</div>
                    <div class="tally__l">Berita acara</div>
                </div>
            </div>
        </div>
    </div>

    <div class="panel">
        <div class="panel__head">
            <div>
                <div class="eyebrow">Jejak</div>
                <h2 class="mt-1">Aktivitas terbaru</h2>
            </div>
            <span class="chip">15 terakhir</span>
        </div>
        <div class="panel__body">
            @if (logs != null && logs.Any())
            {
                <div class="feed">
                    @foreach (var item in logs)
                    {
                        <div class="feed__row">
                            <div class="feed__time">
                                @item.Waktu.ToString("dd/MM/yy")<br />@item.Waktu.ToString("HH:mm")
                            </div>
                            <div>
                                <div class="feed__what">@item.Aktivitas</div>
                                <div class="feed__who">@item.Deskripsi · @item.Username</div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="empty">
                    <h3>Belum ada aktivitas</h3>
                    <p>Login, pembuatan nomor, dan penghapusan surat tercatat di sini.</p>
                </div>
            }
        </div>
    </div>
}
else
{
    var matriks = ViewBag.MatriksBulan as Dictionary<string, int[]> ?? new Dictionary<string, int[]>();
    int puncak = ViewBag.PuncakBulan ?? 0;
    var namaBulan = new[] { "Jan", "Feb", "Mar", "Apr", "Mei", "Jun", "Jul", "Ags", "Sep", "Okt", "Nov", "Des" };
    var warna = new[] { "var(--kpb-blue)", "var(--kpb-red)", "var(--kpb-green)", "var(--ink-2)", "#7A5AA6", "#C77B25" };
    int bulanIni = DateTime.Now.Month;

    <div class="panel mb-4">
        <div class="panel__body">
            <div class="tally">
                <div class="tally__item">
                    <div class="tally__n">@ViewBag.TotalSurat</div>
                    <div class="tally__l">Total berita acara</div>
                </div>
                <div class="tally__item">
                    <div class="tally__n">@ViewBag.TotalTahunIni</div>
                    <div class="tally__l">Tahun @ViewBag.Tahun</div>
                </div>
                @if (ViewBag.JenisTerbanyak != null)
                {
                    <div class="tally__item" style="min-width:220px;">
                        <div style="font-size:20px; font-weight:800; letter-spacing:-0.02em; line-height:1.2;">
                            @ViewBag.JenisTerbanyak
                        </div>
                        <div class="tally__l">Paling sering dibuat</div>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="panel mb-4">
        <div class="panel__head">
            <div>
                <div class="eyebrow">Per bulan · @ViewBag.Tahun</div>
                <h2 class="mt-1">Jenis yang dibuat tiap bulan</h2>
            </div>
        </div>

        <div class="panel__body">
            @if (matriks.Count > 0 && puncak > 0)
            {
                <div class="chart">
                    <div class="chart__plot">
                        @for (int b = 0; b < 12; b++)
                        {
                            int totalBulan = matriks.Values.Sum(v => v[b]);

                            <div class="chart__col">
                                @if (totalBulan > 0)
                                {
                                    <div class="chart__total">@totalBulan</div>
                                }

                                <div class="chart__stack" style="height:@(Math.Round(totalBulan * 100.0 / puncak))%">
                                    @{ int w = 0; }
                                    @foreach (var jenis in matriks)
                                    {
                                        int nilai = jenis.Value[b];
                                        if (nilai > 0)
                                        {
                                            <span class="chart__seg"
                                                  style="height:@(Math.Round(nilai * 100.0 / totalBulan))%; background:@warna[w % warna.Length]"
                                                  title="@namaBulan[b]: @jenis.Key — @nilai"></span>
                                        }
                                        w++;
                                    }
                                </div>

                                @if (totalBulan == 0)
                                {
                                    <div class="chart__kosong" title="@namaBulan[b]: tidak ada"></div>
                                }

                                <div class="chart__x @(b + 1 == bulanIni ? "is-now" : "")">@namaBulan[b]</div>
                            </div>
                        }
                    </div>

                    <div class="legend">
                        @{ int wl = 0; }
                        @foreach (var jenis in matriks)
                        {
                            <span class="legend__item">
                                <span class="legend__dot" style="background:@warna[wl % warna.Length]"></span>
                                @jenis.Key
                                <b class="dist__n">@jenis.Value.Sum()</b>
                            </span>
                            wl++;
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="empty">
                    <h3>Belum ada berita acara tahun @ViewBag.Tahun</h3>
                    <p>Grafik terisi setelah dokumen pertama tahun ini dibuat.</p>
                    <a class="btn btn-primary" asp-controller="Surat" asp-action="Create">Buat berita acara</a>
                </div>
            }
        </div>
    </div>

    <div class="panel">
        <div class="panel__head">
            <div>
                <div class="eyebrow">Sebaran</div>
                <h2 class="mt-1">Per jenis, seluruh tahun</h2>
            </div>
        </div>
        <div class="panel__body">
            @{
                int puncakJenis = 1;
                foreach (var j in ViewBag.SuratPerJenis)
                {
                    int t = (int)j.Total;
                    if (t > puncakJenis) puncakJenis = t;
                }
            }

            @if (((IEnumerable<dynamic>)ViewBag.SuratPerJenis).Any())
            {
                <div class="dist">
                    @foreach (var item in ViewBag.SuratPerJenis)
                    {
                        <div class="dist__row">
                            <span class="dist__name">@item.NamaJenis</span>
                            <span class="dist__n">@item.Total</span>
                            <span class="dist__track">
                                <span class="dist__bar" style="width:@(Math.Round((int)item.Total * 100.0 / puncakJenis))%"></span>
                            </span>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-secondary mb-0">Belum ada data.</p>
            }
        </div>
    </div>
}
