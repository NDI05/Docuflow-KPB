@using Microsoft.AspNetCore.Http
@using Docuflow_projectIT_KPB.Models
@using System.Linq

@{
    ViewData["Title"] = "Beranda";

    var nama = Context.Session.GetString("Nama");
    var role = Context.Session.GetString("Role");

    var perJenis = ViewBag.SuratPerJenis as Dictionary<string, int>;
    var jumlahJenis = perJenis?.Count ?? 0;
}

<section class="kpb-hero">
    <div class="kpb-mark on-dark kpb-hero-mark" aria-hidden="true"><span></span><span></span><span></span></div>

    <div class="kpb-hero-eyebrow">Docuflow &middot; Kilang Pertamina Balikpapan</div>

    <h1>Selamat datang, @(nama ?? "Pengguna").</h1>

    <p>
        @if (role == "Admin")
        {
            <text>Anda mengelola pengguna dan seluruh surat yang tercatat di sistem.</text>
        }
        else
        {
            <text>Buat surat baru atau telusuri arsip berita acara serah terima perangkat.</text>
        }
    </p>
</section>

<div class="row g-3">

    <div class="col-md-4">
        <div class="kpb-stat is-red">
            <div class="kpb-stat-label">Total Surat</div>
            <div class="kpb-stat-value">@ViewBag.TotalSurat</div>
            <div class="kpb-stat-foot">Tercatat di seluruh jenis</div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="kpb-stat">
            <div class="kpb-stat-label">Total Pengguna</div>
            <div class="kpb-stat-value">@ViewBag.TotalUsers</div>
            <div class="kpb-stat-foot">Akun aktif Docuflow</div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="kpb-stat is-green">
            <div class="kpb-stat-label">Jenis Surat</div>
            <div class="kpb-stat-value">@jumlahJenis</div>
            <div class="kpb-stat-foot">Format yang tersedia</div>
        </div>
    </div>

</div>

<div class="kpb-section">
    <div class="kpb-mark" aria-hidden="true"><span></span><span></span><span></span></div>
    <h2>Surat per Jenis</h2>
    <div class="kpb-rule"></div>
</div>

@if (perJenis != null && perJenis.Any())
{
    <div class="row g-3">
        @foreach (var item in perJenis.OrderByDescending(x => x.Value))
        {
            <div class="col-lg-3 col-md-4 col-sm-6">
                <div class="kpb-tile">
                    <div class="kpb-tile-name">@item.Key</div>
                    <div class="kpb-tile-value">@item.Value</div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="kpb-panel">
        <div class="kpb-empty">Belum ada jenis surat yang terdaftar.</div>
    </div>
}

@if (role == "Admin")
{
    <div class="kpb-section">
        <div class="kpb-mark" aria-hidden="true"><span></span><span></span><span></span></div>
        <h2>Aktivitas Terbaru</h2>
        <div class="kpb-rule"></div>
    </div>

    <div class="kpb-panel">
        <div class="kpb-panel-body">

            @{
                var logs = ViewBag.AktivitasTerbaru as List<AuditLog>;
            }

            @if (logs != null && logs.Any())
            {
                var groupedLogs = logs
                    .GroupBy(x => x.Aktivitas)
                    .OrderByDescending(x => x.Count());

                foreach (var group in groupedLogs)
                {
                    <div class="kpb-log-item">

                        <div class="kpb-log-head">
                            <span>@group.Key</span>
                            <span class="kpb-log-count">@group.Count()</span>
                        </div>

                        @foreach (var item in group.Take(5))
                        {
                            <div class="kpb-log-entry">
                                @item.Username &middot; @item.Waktu.ToString("dd/MM/yyyy HH:mm")
                            </div>
                        }

                        @if (group.Count() > 5)
                        {
                            <div class="kpb-log-entry">
                                +@(group.Count() - 5) aktivitas lainnya
                            </div>
                        }

                    </div>
                }
            }
            else
            {
                <div class="kpb-empty">Belum ada aktivitas tercatat.</div>
            }

        </div>
    </div>
}
