@{
    ViewData["Title"] = "Dashboard";
}

<div class="row">

    <div class="col-md-4">
        <div class="card text-white bg-primary shadow mb-3">
            <div class="card-body">
                <h5 class="card-title">Total Users</h5>
                <h2>@ViewBag.TotalUsers</h2>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card text-white bg-success shadow mb-3">
            <div class="card-body">
                <h5 class="card-title">Total Surat</h5>
                <h2>@ViewBag.TotalSurat</h2>
            </div>
        </div>
    </div>

    <hr />
    <h4>Total Surat per Jenis</h4>

    <div class="row">
        @foreach (var item in ViewBag.SuratPerJenis)
        {
            <div class="col-md-3 mb-3">
                <div class="card text-white bg-info">
                    <div class="card-body">
                        <h5 class="card-title">@item.NamaJenis</h5>
                        <h3>@item.Total</h3>
                    </div>
                </div>
            </div>
        }
    </div>

</div>