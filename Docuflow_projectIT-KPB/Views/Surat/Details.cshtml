@model Docuflow_projectIT_KPB.Models.Surat

@{
    ViewData["Title"] = "Detail berita acara";
    ViewData["Eyebrow"] = Model.JenisSurat?.NamaJenis ?? "Berita acara";

    // Baris keterangan hanya muncul kalau ada isinya. Deretan "—" tidak
    // memberi tahu apa pun selain bahwa formulirnya panjang.
    var balpLabel = Docuflow_projectIT_KPB.Services.Balp.Adalah(Model.JenisSurat?.Kode);

    var keterangan = new (string Label, string Nilai)[]
    {
        (balpLabel ? "Nama perusahaan" : "Tujuan", Model.Tujuan),
        ("Tentang",           Model.Tentang),
        (balpLabel ? "Keterangan BALP" : "Deskripsi", Model.Deskripsi),
        ("Dasar",             Model.JenisTiket),
        ("Nomor",             Model.NoTiket),
        ("Yang menerima",     Model.YangMenerima),
        ("Jabatan penerima",  Model.JabatanYangMenerima),
    };

    // Kolom mana yang berarti pada daftar barang ditentukan bentuk dokumennya,
    // bukan hanya kodenya: dua jenis BAST punya susunan kolom yang berbeda.
    var bapb = string.Equals(Model.JenisSurat?.Kode?.Trim(), "BAPB", StringComparison.OrdinalIgnoreCase);
    var cctv = Docuflow_projectIT_KPB.Services.Bast.Cctv(Model.JenisSurat?.NamaJenis);

    // BALP tidak dicetak Docuflow; yang diarsipkan adalah berkas dari vendor.
    var balp = Docuflow_projectIT_KPB.Services.Balp.Adalah(Model.JenisSurat?.Kode);

    var penanggungJawab = new (string Label, string Nilai)[]
    {
        ("Nama",              Model.NamaPenanggungJawab),
        ("Jabatan",           Model.Jabatan),
        ("Fungsi/direktorat", Model.FungsiDirektorat),
        ("Nomor pekerja",     Model.NoPekerja),
        ("Alamat",            Model.Alamat),
    };
}

@* Aksi cetak menempel pada kartu nomor surat — di situlah dokumennya
   diidentifikasi, jadi di situ pula tombol yang menghasilkannya. *@
<div class="panel mb-4">
    <div class="panel__body d-flex flex-wrap justify-content-between align-items-center gap-3">
        <div>
            <div class="eyebrow mb-2">Nomor berita acara</div>
            <div class="nomor--lg">
                @await Html.PartialAsync("_Nomor", Model)
            </div>
        </div>

        <div class="text-end">
            @* BALP punya dua tanggal: penerbitan nomor dan tanggal pada surat
               vendor. Yang ditonjolkan tanggal suratnya, karena itu yang berlaku
               sebagai tanggal dokumen. *@
            <div class="tally__l">@(balp ? "Tanggal surat" : "Tanggal")</div>
            <div style="font-size:17px; font-weight:700;">
                @if (balp)
                {
                    @(Model.TanggalBalp?.ToString("dd MMMM yyyy") ?? "Belum ada")
                }
                else
                {
                    @Model.Tanggal.ToString("dd MMMM yyyy")
                }
            </div>
            @if (balp)
            {
                <div class="tally__l mt-1">Nomor terbit @Model.Tanggal.ToString("dd MMM yyyy")</div>
            }
        </div>

        <div class="d-flex gap-2 flex-wrap">
            @if (balp)
            {
                @* Tidak ada Pratinjau maupun Cetak PDF: suratnya dibuat vendor,
                   Docuflow hanya menerbitkan nomornya. *@
                <a class="btn @(string.IsNullOrEmpty(Model.FilePath) ? "btn-primary" : "btn-outline-secondary")"
                   asp-action="UnggahBalp" asp-route-id="@Model.Id">
                    @(string.IsNullOrEmpty(Model.FilePath) ? "Unggah berkas BALP" : "Ganti berkas")
                </a>

                @if (!string.IsNullOrEmpty(Model.FilePath))
                {
                    <a class="btn btn-primary" asp-action="Download" asp-route-id="@Model.Id">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <path d="M12 3v12m0 0-4-4m4 4 4-4M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/>
                        </svg>
                        Unduh berkas
                    </a>
                }
            }
            else
            {
                <a class="btn btn-outline-secondary" asp-action="Preview" asp-route-id="@Model.Id" target="_blank" rel="noopener">Pratinjau</a>
                <a class="btn btn-primary" asp-action="GeneratePdf" asp-route-id="@Model.Id">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                        <path d="M6 9V3h12v6M6 18H5a2 2 0 0 1-2-2v-4a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2h-1M6 14h12v7H6z"/>
                    </svg>
                    Cetak PDF
                </a>
            }
        </div>
    </div>
</div>

<div class="row g-4">

    <div class="col-lg-7">

        <div class="panel mb-4">
            <div class="panel__head"><h2>Keterangan</h2></div>
            <div class="panel__body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 form-label pt-1">Jenis</dt>
                    <dd class="col-sm-8">@(Model.JenisSurat?.NamaJenis ?? "—")</dd>

                    @foreach (var baris in keterangan)
                    {
                        if (!string.IsNullOrWhiteSpace(baris.Nilai))
                        {
                            <dt class="col-sm-4 form-label pt-1">@baris.Label</dt>
                            <dd class="col-sm-8">@baris.Nilai</dd>
                        }
                    }
                </dl>
            </div>
        </div>

        @* BALP tidak punya isi dokumen di sistem — suratnya dibuat vendor.
           Panel barang, penanggung jawab, dan penanda tangan disembunyikan
           daripada dicetak sebagai deretan "—" yang tidak memberi tahu apa pun. *@
        @if (balp)
        {
            <div class="panel">
                <div class="panel__head"><h2>Berkas dari vendor</h2></div>
                <div class="panel__body">
                    @if (string.IsNullOrEmpty(Model.FilePath))
                    {
                        <div class="empty">
                            <h3>Berkas belum diunggah</h3>
                            <p>Nomor sudah terbit dan bisa diserahkan ke vendor. Unggah suratnya setelah jadi.</p>
                            <a class="btn btn-primary" asp-action="UnggahBalp" asp-route-id="@Model.Id">Unggah berkas BALP</a>
                        </div>
                    }
                    else
                    {
                        <dl class="row mb-0">
                            <dt class="col-5 form-label pt-1">Tanggal pada surat</dt>
                            <dd class="col-7">@(Model.TanggalBalp?.ToString("dd MMMM yyyy") ?? "—")</dd>

                            <dt class="col-5 form-label pt-1">Berkas</dt>
                            <dd class="col-7 mb-0">
                                <a asp-action="Download" asp-route-id="@Model.Id">Unduh surat vendor</a>
                            </dd>
                        </dl>
                    }
                </div>
            </div>
        }
        else if (Model.PoinList != null && Model.PoinList.Any())
        {
            var hitung = new int[3];

            <div class="panel">
                <div class="panel__head">
                    <h2>Poin laporan</h2>
                    <span class="chip">@Model.PoinList.Count poin</span>
                </div>
                <div class="panel__body">
                    @foreach (var poin in Model.PoinList)
                    {
                        var lv = Math.Clamp(poin.Level, 0, 2);
                        hitung[lv]++;
                        for (var d = lv + 1; d < hitung.Length; d++) { hitung[d] = 0; }
                        var no = string.Join(".", hitung.Take(lv + 1));

                        <div class="mb-3" style="margin-left:@(lv * 24)px;">
                            <div style="font-weight:700;">
                                <span class="dist__n" style="min-width:44px; display:inline-block;">@no</span>@poin.Judul
                            </div>

                            @if (!string.IsNullOrWhiteSpace(poin.Keterangan))
                            {
                                <div class="text-secondary" style="margin-left:44px;">@poin.Keterangan</div>
                            }

                            @if (poin.Gambar != null && poin.Gambar.Any())
                            {
                                <div style="margin-left:44px; margin-top:8px; display:flex; flex-wrap:wrap; gap:8px;">
                                    @foreach (var g in poin.Gambar)
                                    {
                                        <a href="@Url.Content("~" + g.FilePath)" target="_blank" rel="noopener">
                                            <img src="@Url.Content("~" + g.FilePath)" alt="Lampiran poin @no"
                                                 style="max-width:160px; max-height:110px; border:1px solid var(--rule); border-radius:var(--r-chip);" />
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
        else
        {
        <div class="panel">
            <div class="panel__head">
                <h2>Daftar barang</h2>
                <span class="chip">@(Model.BarangList?.Count ?? 0) baris</span>
            </div>

            @if (Model.BarangList != null && Model.BarangList.Any())
            {
                <div class="ledger--wrap">
                    <table class="ledger">
                        @* Kolom mengikuti jenis dokumennya, sama seperti pada
                           formulir dan hasil cetak: BAPB tidak punya nama
                           barang maupun pengguna, dan kolom "—" berderet tidak
                           memberi tahu apa pun. *@
                        <thead>
                            <tr>
                                <th style="width:40px;">#</th>
                                @if (bapb)
                                {
                                    <th style="width:80px;">Jumlah</th>
                                    <th style="width:80px;">Satuan</th>
                                    <th>Serial number</th>
                                    <th>Merk / tipe</th>
                                    <th>Keterangan</th>
                                }
                                else if (cctv)
                                {
                                    <th>Barang</th>
                                    <th>Tanggal</th>
                                    <th>Jam</th>
                                    <th>Rekaman</th>
                                    <th>Area</th>
                                }
                                else
                                {
                                    <th>Barang</th>
                                    <th>Serial number</th>
                                    <th>Merk / tipe</th>
                                    <th>Pengguna</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                            @{ int n = 0; }
                            @foreach (var b in Model.BarangList)
                            {
                                n++;
                                <tr>
                                    <td class="num">@n</td>
                                    @if (bapb)
                                    {
                                        <td class="num">@(b.Jumlah?.ToString() ?? "—")</td>
                                        <td>@(string.IsNullOrWhiteSpace(b.Satuan) ? "pcs" : b.Satuan)</td>
                                        <td class="serial">@(string.IsNullOrWhiteSpace(b.SerialNumber) ? "—" : b.SerialNumber)</td>
                                        <td>@(string.IsNullOrWhiteSpace(b.MerkType) ? "—" : b.MerkType)</td>
                                        <td>@(string.IsNullOrWhiteSpace(b.Keterangan) ? "—" : b.Keterangan)</td>
                                    }
                                    else if (cctv)
                                    {
                                        <td>@b.NamaBarang</td>
                                        <td>@(string.IsNullOrWhiteSpace(b.Tanggal) ? "—" : b.Tanggal)</td>
                                        <td>@(string.IsNullOrWhiteSpace(b.Jam) ? "—" : b.Jam)</td>
                                        <td>@(string.IsNullOrWhiteSpace(b.Rekaman) ? "—" : b.Rekaman)</td>
                                        <td>@(string.IsNullOrWhiteSpace(b.Area) ? "—" : b.Area)</td>
                                    }
                                    else
                                    {
                                        <td>@b.NamaBarang</td>
                                        <td class="serial">@(string.IsNullOrWhiteSpace(b.SerialNumber) ? "—" : b.SerialNumber)</td>
                                        <td>@(string.IsNullOrWhiteSpace(b.MerkType) ? "—" : b.MerkType)</td>
                                        <td>@(string.IsNullOrWhiteSpace(b.Pengguna) ? "—" : b.Pengguna)</td>
                                    }
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="empty">
                    <h3>Tidak ada barang tercatat</h3>
                    <p>Berita acara ini dibuat tanpa daftar barang.</p>
                </div>
            }
        </div>
        }

    </div>

    <div class="col-lg-5">

        @if (!balp)
        {
        <div class="panel mb-4">
            <div class="panel__head"><h2>Penanggung jawab</h2></div>
            <div class="panel__body">
                @if (penanggungJawab.Any(p => !string.IsNullOrWhiteSpace(p.Nilai)))
                {
                    <dl class="row mb-0">
                        @foreach (var baris in penanggungJawab)
                        {
                            if (!string.IsNullOrWhiteSpace(baris.Nilai))
                            {
                                <dt class="col-5 form-label pt-1">@baris.Label</dt>
                                <dd class="col-7">@baris.Nilai</dd>
                            }
                        }
                    </dl>
                }
                else
                {
                    <p class="text-secondary mb-0">Data penanggung jawab tidak diisi.</p>
                }
            </div>
        </div>

        <div class="panel mb-4">
            <div class="panel__head"><h2>Penanda tangan</h2></div>
            <div class="panel__body">
                <dl class="row mb-0">
                    <dt class="col-5 form-label pt-1">Staff</dt>
                    <dd class="col-7">@(Model.Staff?.Nama ?? "—")</dd>

                    <dt class="col-5 form-label pt-1">Mengetahui</dt>
                    <dd class="col-7 mb-0">@(Model.Manager?.Nama ?? "—")</dd>
                </dl>
            </div>
        </div>
        }

        @* Pada BALP berkas vendornya BUKAN lampiran — ia dokumennya sendiri,
           dan sudah punya panel "Berkas dari vendor". Dua panel untuk satu
           berkas hanya membuat orang bertanya mana yang benar. *@
        @if (!balp)
        {
        <div class="panel">
            <div class="panel__head"><h2>Lampiran</h2></div>
            <div class="panel__body">
                @if (!string.IsNullOrWhiteSpace(Model.FilePath))
                {
                    <a class="btn btn-outline-secondary w-100" asp-action="Download" asp-route-id="@Model.Id">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                            <path d="M12 3v12m0 0 4-4m-4 4-4-4M4 19h16"/>
                        </svg>
                        Unduh berkas terlampir
                    </a>
                }
                else
                {
                    <p class="text-secondary mb-0">Tidak ada berkas terlampir.</p>
                }
            </div>
        </div>
        }

    </div>
</div>

<div class="d-flex justify-content-between align-items-center mt-4">
    <a class="btn btn-outline-secondary" asp-action="Index">Kembali ke arsip</a>

    <form asp-action="Delete" method="post"
          onsubmit="return confirm('Hapus berita acara @Model.NomorSurat? Tindakan ini tidak bisa dibatalkan.');">
        @Html.AntiForgeryToken()
        <input type="hidden" name="id" value="@Model.Id" />
        <button type="submit" class="btn btn-outline-secondary text-danger">Hapus berita acara</button>
    </form>
</div>
