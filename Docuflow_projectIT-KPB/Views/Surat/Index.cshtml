@model List<Docuflow_projectIT_KPB.Models.Surat>

@{
    ViewData["Title"] = "Berita Acara";
    ViewData["Eyebrow"] = "Arsip";

    int halaman = ViewBag.CurrentPage ?? 1;
    int totalHalaman = ViewBag.TotalPages ?? 1;
    string cari = ViewBag.Search ?? "";

    ViewData["Sub"] = string.IsNullOrEmpty(cari)
        ? "Semua dokumen yang pernah diterbitkan."
        : $"Hasil pencarian untuk “{cari}”.";

    // Jendela pagination: pertama, terakhir, dan sekitar halaman aktif.
    // Merender seluruh nomor halaman jadi tembok angka begitu arsip membesar.
    var jendela = new List<int>();
    for (int i = 1; i <= totalHalaman; i++)
    {
        if (i == 1 || i == totalHalaman || (i >= halaman - 2 && i <= halaman + 2))
        {
            jendela.Add(i);
        }
    }
}

<div class="panel">

    @* Aksi utama sejajar dengan pencarian: keduanya milik halaman ini, dan
       yang dicari orang di sini adalah "temukan" atau "buat baru". *@
    <div class="panel__head">
        <form method="get" asp-action="Index" class="finder" role="search">
            <input type="search" name="search" value="@cari" class="form-control"
                   placeholder="Cari nomor, jenis, atau nama staff"
                   aria-label="Cari berita acara" />
            <button type="submit" class="btn btn-outline-secondary">Cari</button>
            @if (!string.IsNullOrEmpty(cari))
            {
                <a class="btn btn-outline-secondary" asp-action="Index">Bersihkan</a>
            }
        </form>

        <a class="btn btn-primary" asp-action="Create">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M12 5v14M5 12h14"/>
            </svg>
            Buat berita acara
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="ledger--wrap">
            <table class="ledger">
                <thead>
                    <tr>
                        <th>Nomor</th>
                        <th>Jenis</th>
                        <th>Tanggal</th>
                        <th>Staff</th>
                        <th><span class="visually-hidden">Aksi</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id">
                                    @await Html.PartialAsync("_Nomor", item.NomorSurat)
                                </a>
                            </td>

                            <td>@(item.JenisSurat?.NamaJenis ?? "—")</td>

                            <td>
                                @item.Tanggal.ToString("dd/MM/yyyy")
                                <div class="feed__time">@((item.CreatedAt ?? item.Tanggal).ToString("HH:mm"))</div>
                            </td>

                            <td>@(item.Staff?.Nama ?? "—")</td>

                            <td>
                                <div class="d-flex gap-2 justify-content-end">
                                    <a class="btn btn-outline-secondary btn-sm"
                                       asp-action="Details" asp-route-id="@item.Id">Detail</a>

                                    <a class="btn btn-outline-secondary btn-sm"
                                       asp-action="GeneratePdf" asp-route-id="@item.Id">PDF</a>

                                    <form asp-action="Delete" method="post" class="d-inline"
                                          onsubmit="return confirm('Hapus berita acara @item.NomorSurat? Tindakan ini tidak bisa dibatalkan.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-outline-secondary btn-sm text-danger">Hapus</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="panel__body">
            <div class="pager">
                <span class="pager__info">Halaman @halaman dari @totalHalaman</span>

                <nav class="pager__links" aria-label="Navigasi halaman">
                    <a class="@(halaman == 1 ? "is-disabled" : "")"
                       asp-action="Index" asp-route-page="@(halaman - 1)" asp-route-search="@cari"
                       aria-label="Halaman sebelumnya">‹</a>

                    @{ int sebelumnya = 0; }
                    @foreach (var n in jendela)
                    {
                        if (sebelumnya > 0 && n - sebelumnya > 1)
                        {
                            <span class="is-disabled">…</span>
                        }

                        if (n == halaman)
                        {
                            <span class="is-current" aria-current="page">@n</span>
                        }
                        else
                        {
                            <a asp-action="Index" asp-route-page="@n" asp-route-search="@cari">@n</a>
                        }

                        sebelumnya = n;
                    }

                    <a class="@(halaman == totalHalaman ? "is-disabled" : "")"
                       asp-action="Index" asp-route-page="@(halaman + 1)" asp-route-search="@cari"
                       aria-label="Halaman berikutnya">›</a>
                </nav>
            </div>
        </div>
    }
    else
    {
        <div class="empty">
            @if (!string.IsNullOrEmpty(cari))
            {
                <h3>Tidak ada yang cocok</h3>
                <p>Tidak ada berita acara dengan nomor, jenis, atau staff yang mengandung “@cari”.</p>
                <a class="btn btn-outline-secondary" asp-action="Index">Tampilkan semua</a>
            }
            else
            {
                <h3>Arsip masih kosong</h3>
                <p>Berita acara yang dibuat akan tersimpan dan bisa dicetak ulang dari sini.</p>
                <a class="btn btn-primary" asp-action="Create">Buat berita acara</a>
            }
        </div>
    }

</div>
