@model List<Docuflow_projectIT_KPB.Models.Surat>

@{
    ViewData["Title"] = "Daftar Surat";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string search = ViewBag.Search ?? "";
}

<style>
    .table thead th {
        text-align: center;
        vertical-align: middle;
        font-weight: 800;
        font-size: 14px;
    }

    .table tbody td {
        vertical-align: middle;
        font-size: 13px;
    }

    .pagination .page-link {
        border-radius: 10px;
        margin: 0 3px;
        font-weight: 700;
        color: #0d1a8a;
    }

    .pagination .active .page-link {
        background: #0d1a8a;
        border-color: #0d1a8a;
        color: white;
    }

    .btn-action {
        border-radius: 10px;
        font-weight: 700;
        font-size: 12px;
        padding: 6px 12px;
    }

    .table-custom {
        background: white;
        border-radius: 14px;
        overflow: hidden;
    }

    .wrap-text {
        white-space: normal !important;
        word-break: break-word;
    }
</style>

<div class="card shadow-lg border-0" style="border-radius:18px; overflow:hidden;">

    <div class="card-header d-flex justify-content-between align-items-center"
         style="background:#c6c8d9; padding:15px 20px;">

        <h5 class="mb-0 fw-bold text-dark">Daftar Surat</h5>

        <div class="d-flex gap-2 align-items-center">

            <!-- SEARCH FORM -->
            <form method="get" asp-action="Index" class="d-flex gap-2 align-items-center">
                <input type="text"
                       name="search"
                       value="@search"
                       class="form-control form-control-sm"
                       placeholder="Search"
                       style="border-radius:12px; width:220px;" />

                <button type="submit"
                        class="btn btn-primary btn-sm"
                        style="border-radius:12px; font-weight:700;">
                    Cari
                </button>
            </form>

            <a href="/Surat/Create"
                   class="btn btn-primary btn-sm"
                   style="border-radius:12px; font-weight:700;">
                Buat Surat +
            </a>

        </div>
    </div>

    <div class="card-body" style="background:#f4f6fb;">

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success">
                @TempData["Message"]
            </div>
        }

        <div class="table-responsive table-custom">
            <table class="table table-bordered table-hover align-middle mb-0 w-100">

                <thead style="background:#c6c8d9;">
                    <tr>
                        <th style="width:260px;">Nomor</th>
                        <th style="width:380px;">Jenis Surat</th>
                        <th style="width:140px;">Tanggal Surat</th>
                        <th style="width:140px;">Staff</th>
                        <th style="width:120px;">Upload</th>
                        <th style="width:260px;">Aksi</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="wrap-text fw-bold">
                                    @(item.NomorSurat ?? "-")
                                </td>

                                <td class="wrap-text">
                                    @(item.JenisSurat?.NamaJenis ?? "-")
                                </td>

                                <td class="text-center">
                                    @item.Tanggal.ToString("dd/MM/yyyy")
                                </td>

                                <td class="text-center">
                                    @(item.Staff?.Nama ?? "-")
                                </td>

                                <td class="text-center">
                                    @((item.CreatedAt ?? item.Tanggal).ToString("HH:mm:ss"))
                                </td>

                                <td class="text-center">

                                    <a href="/Surat/Details/@item.Id"
                                           class="btn btn-info btn-sm text-white btn-action">
                                        Detail
                                    </a>

                                    <a href="/Surat/GeneratePDF/@item.Id"
                                           class="btn btn-warning btn-sm text-white btn-action">
                                        Download
                                    </a>

                                    <form asp-controller="Surat"
                                          asp-action="Delete"
                                          method="post"
                                          style="display:inline"
                                          onsubmit="return confirm('Yakin ingin menghapus surat ini?');">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="id" value="@item.Id" />

                                        <button type="submit"
                                                class="btn btn-danger btn-sm btn-action">
                                            Delete
                                        </button>
                                    </form>

                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">
                                Belum ada data surat
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>

        <!-- PAGINATION -->
        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="text-muted" style="font-size:14px;">
                Page <b>@currentPage</b> of <b>@totalPages</b>
            </div>

            <nav>
                <ul class="pagination mb-0">

                    <!-- Prev -->
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                               href="/Surat/Index?page=@(currentPage - 1)&search=@search">
                            &laquo;
                        </a>
                    </li>

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link"
                                   href="/Surat/Index?page=@i&search=@search">
                                @i
                            </a>
                        </li>
                    }

                    <!-- Next -->
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link"
                               href="/Surat/Index?page=@(currentPage + 1)&search=@search">
                            &raquo;
                        </a>
                    </li>

                </ul>
            </nav>
        </div>

    </div>
</div>