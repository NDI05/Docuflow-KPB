@model List<Docuflow_projectIT_KPB.Models.Surat>

@{
    ViewData["Title"] = "Daftar Surat";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string search = ViewBag.Search ?? "";
}

<div class="kpb-head">
    <div>
        <h1>Daftar Surat</h1>
        <p>Arsip berita acara dan serah terima perangkat IT.</p>
    </div>

    <div class="kpb-head-actions">
        <form method="get" asp-action="Index" class="kpb-search" role="search">
            <input type="text"
                   name="search"
                   value="@search"
                   class="form-control"
                   aria-label="Cari nomor surat atau jenis"
                   placeholder="Cari nomor atau jenis surat" />

            <button type="submit" class="btn btn-ghost-ink btn-sm">Cari</button>
        </form>

        <a asp-action="Create" class="btn btn-on-ink btn-sm">
            <i class="bi bi-plus-lg"></i> Buat Surat
        </a>
    </div>
</div>

<div class="kpb-panel-body">

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success" role="status">@TempData["Message"]</div>
    }

    <div class="kpb-table-wrap">
        <table class="kpb-table">

            <thead>
                <tr>
                    <th style="min-width:220px;">Nomor Surat</th>
                    <th style="min-width:280px;">Jenis Surat</th>
                    <th class="is-center">Tanggal</th>
                    <th class="is-center">Staff</th>
                    <th class="is-center">Dibuat</th>
                    <th class="is-center" style="min-width:230px;">Aksi</th>
                </tr>
            </thead>

            <tbody>
                @if (Model != null && Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>
                            <td class="is-key">@(item.NomorSurat ?? "-")</td>

                            <td>@(item.JenisSurat?.NamaJenis ?? "-")</td>

                            <td class="is-center">@item.Tanggal.ToString("dd/MM/yyyy")</td>

                            <td class="is-center">@(item.Staff?.Nama ?? "-")</td>

                            <td class="is-center">@((item.CreatedAt ?? item.Tanggal).ToString("HH:mm"))</td>

                            <td>
                                <div class="kpb-actions">
                                    <a href="/Surat/Details/@item.Id" class="btn btn-outline-ink btn-sm">
                                        Detail
                                    </a>

                                    <a href="/Surat/GeneratePDF/@item.Id" class="btn btn-outline-ink btn-sm">
                                        Unduh PDF
                                    </a>

                                    <form asp-controller="Surat"
                                          asp-action="Delete"
                                          method="post"
                                          onsubmit="return confirm('Hapus surat @(item.NomorSurat)? Tindakan ini tidak bisa dibatalkan.');">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="id" value="@item.Id" />

                                        <button type="submit" class="btn btn-outline-danger btn-sm">Hapus</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="is-empty">
                            @if (string.IsNullOrWhiteSpace(search))
                            {
                                <text>Belum ada surat. Mulai dengan menekan &ldquo;Buat Surat&rdquo;.</text>
                            }
                            else
                            {
                                <text>Tidak ada surat yang cocok dengan &ldquo;@search&rdquo;.</text>
                            }
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>

    <div class="kpb-pager">
        <div class="kpb-pager-count">
            Halaman <b>@currentPage</b> dari <b>@totalPages</b>
        </div>

        <nav aria-label="Navigasi halaman">
            <ul class="pagination">

                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="/Surat/Index?page=@(currentPage - 1)&search=@search" aria-label="Sebelumnya">&laquo;</a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="/Surat/Index?page=@i&search=@search">@i</a>
                    </li>
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" href="/Surat/Index?page=@(currentPage + 1)&search=@search" aria-label="Berikutnya">&raquo;</a>
                </li>

            </ul>
        </nav>
    </div>

</div>
