@using Docuflow_projectIT_KPB.Services
@model Docuflow_projectIT_KPB.Models.Surat
@{
    Layout = null;

    // Ditandai GeneratePdf. Lihat blok hiasan layar di bawah.
    var cetak = ViewData["Cetak"] as bool? == true;

    // Survey memakai tata letak judul terpusat: kop di kanan atas, lalu
    // "BERITA ACARA", nomor, dan perihal di bawah label TENTANG. Kerusakan
    // tetap memakai kop lama. Aturannya dijawab Ba, sumber yang sama dengan
    // yang dipakai formulir Create untuk memunculkan isian Tentang.
    var survey = Ba.Survey(Model.JenisSurat?.NamaJenis);

    // Penomoran 1 / 1.1 / 1.1.1 dihitung dari urutan dan level, sama seperti
    // di penyunting. Tidak disimpan di database supaya tidak pernah basi.
    var hitung = new int[3];

    string NomorPoin(int level)
    {
        level = Math.Clamp(level, 0, 2);
        hitung[level]++;
        for (var d = level + 1; d < hitung.Length; d++) hitung[d] = 0;
        return string.Join(".", hitung.Take(level + 1));
    }
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <title>@Model.NomorSurat</title>

    <style>
        /* Margin nol: jarak tepi yang sebenarnya adalah padding .page-content.
           Kalau @@page juga diberi margin, keduanya bertumpuk dan isi halaman
           menyusut jadi kotak kecil di tengah. */
        @@page { size: A4; margin: 0; }

        body {
            margin: 0; padding: 0;
            font-family: Arial, Helvetica, sans-serif;
            font-size: 12px; line-height: 1.5; letter-spacing: 0.09em; text-rendering: geometricPrecision; color: #000; background: #fff;
        }

        /* Persis satu lembar A4, tanpa jarak dan tanpa bayangan; keduanya
           ditambahkan kembali hanya untuk layar. */
        /* min-height hanya untuk layar: 297mm = 1122,52px pada 96 dpi, setengah
           piksel lebih tinggi daripada bidang cetak wkhtmltopdf, dan itu
           cukup untuk melahirkan satu halaman kosong di belakang. */
        .paper { width: 210mm; margin: 0 auto; background: #fff; box-sizing: border-box; }
        .page-content { padding: 20mm 18mm 20mm 18mm; box-sizing: border-box; }

        .header { position: relative; min-height: 112px; margin-bottom: 15px; }
        .logo { position: absolute; top: 0; left: 0; width: 115px; }
        .header-center { text-align: center; padding-top: 5px; margin-left: 120px; margin-right: 288px; }
        .company     { font-size: 16px; font-weight: bold; }
        .company-sub { font-size: 16px; font-weight: bold; margin-top: 2px; }
        .alamat      { margin-top: 6px; font-size: 11px; letter-spacing: 0.03em; }

        .box-info { position: absolute; top: 0; right: 0; width: 278px; border: 1px solid #000; border-collapse: collapse; font-size: 11px; }
        .box-info td { border-bottom: 1px solid #000; padding: 4px 6px; vertical-align: top; }
        .box-info tr:last-child td { border-bottom: none; }
        .box-info .label { width: 52px; white-space: nowrap; }
        .box-info .separator { width: 10px; text-align: center; }
        .box-info .value { font-weight: bold; }

        .title { text-align: center; font-size: 14px; font-weight: bold; text-decoration: underline; margin: 18px 0 4px; }
        .subtitle { text-align: center; font-size: 11px; margin-bottom: 18px; }

        /* Tata letak judul terpusat (Survey). Kop hanya logo di kanan atas,
           tanpa blok nama perusahaan — mengikuti bentuk dokumen yang diminta. */
        .kop { text-align: right; margin-bottom: 10px; }
        .kop img { width: 130px; }

        .judul-pusat { text-align: center; font-size: 15px; font-weight: bold; text-decoration: underline; margin: 4px 0 3px; }
        .nomor-pusat { text-align: center; font-size: 12px; margin-bottom: 14px; }
        .tentang-label { text-align: center; font-size: 12px; letter-spacing: 0.08em; margin-bottom: 4px; }
        .tentang-isi { text-align: center; font-size: 13px; font-weight: bold; margin-bottom: 20px; }

        .deskripsi { text-align: justify; margin-bottom: 18px; }

        /* Poin laporan. Lekukan kiri menandai kedalaman, sama seperti di form. */
        .poin { margin-bottom: 12px; }
        .poin-1 { margin-left: 24px; }
        .poin-2 { margin-left: 48px; }

        .poin-judul { font-weight: bold; margin-bottom: 3px; }
        .poin-judul .no { display: inline-block; min-width: 34px; }
        .poin-ket { text-align: justify; margin-left: 34px; }

        .poin-gambar { margin: 8px 0 0 34px; }
        .poin-gambar img {
            max-width: 240px; max-height: 170px;
            border: 1px solid #999; padding: 2px;
            margin: 0 8px 8px 0;
        }

        .penutup { margin: 20px 0; text-align: justify; }

        .signature { width: 100%; margin-top: 28px; border-collapse: collapse; letter-spacing: 0.04em; }
        .signature td { width: 33.33%; text-align: center; vertical-align: top; font-size: 11.5px; }
        /* Dua kotak harus tetap memenuhi lebar halaman; 33% menyisakan
           sepertiga kosong di kanan. */
        .signature--dua td { width: 50%; }
        .signature .ruang { height: 62px; }
        .signature-name { font-weight: bold; text-decoration: underline; }
    
            /* Tanggal tanda tangan tidak boleh pecah dua baris: bentuknya
               baku "Balikpapan, 07 September 2026". Dengan nowrap, kolom ini
               yang melebar dan tiga kolom lain menyusut — bukan teksnya yang
               membungkus. */
            .tanggal-ttd { white-space: nowrap; }
</style>
@if (!cetak)
{
    @* Hiasan layar — latar abu, bayangan, dan jarak di sekeliling kertas —
       hanya untuk pratinjau di peramban. Ditulis di sini, bukan di blok CSS
       utama, karena tiga hal itu ikut TERCETAK kalau tidak dipisahkan:
       latar abu jadi bidang abu di seluruh halaman, bayangan jadi garis
       kelabu di tepi, dan margin luar menggeser kertas sehingga isinya
       mengecil — hasilnya mirip hasil pindai, bukan dokumen.

       Dua penjaga, masing-masing menutup satu jalur cetak yang berbeda:
       blok ini tidak dirender sama sekali saat wkhtmltopdf yang memanggil,
       dan @@media screen menjaga Ctrl+P dari halaman pratinjau. *@
    <style>
        @@media screen {
            body { background: #f2f2f2; }
            .paper { margin: 15px auto; box-shadow: 0 0 10px rgba(0,0,0,0.15);
                     min-height: 297mm; }
        }
    </style>
}
</head>

<body>

<div class="paper">
    <div class="page-content">

        @if (survey)
        {
            <div class="kop">
                @* Logo resmi Kilang Pertamina Balikpapan — bukan Logo_pertamina.png,
                   yang memakai merah/biru/hijau RGB murni dan bukan warna merek. *@
                <img src="@Url.Content("~/images/kpb-logo.png")" alt="Kilang Pertamina Balikpapan" />
            </div>

            <div class="judul-pusat">BERITA ACARA</div>
            <div class="nomor-pusat">Nomor : @Model.NomorSurat</div>
            <div class="tentang-label">TENTANG</div>
            <div class="tentang-isi">@Model.Tentang</div>
        }
        else
        {
        <div class="header">
            <img src="@Url.Content("~/images/kpb-logo.png")" class="logo" alt="Kilang Pertamina Balikpapan" />

            <div class="header-center">
                <div class="company">PT KILANG PERTAMINA</div>
                <div class="company-sub">BALIKPAPAN</div>
                <div class="alamat">
                    Kantor NSO PT Kilang Pertamina Balikpapan<br />
                    JL. Yos Sudarso No.1 Balikpapan
                </div>
            </div>

            @* Tanpa baris Tanggal: dokumen BA sengaja tidak bertanggal. *@
            <table class="box-info">
                <tr>
                    <td class="label">Nomor</td>
                    <td class="separator">:</td>
                    <td class="value">@Model.NomorSurat</td>
                </tr>
                <tr>
                    <td class="label">Dari</td>
                    <td class="separator">:</td>
                    <td class="value">Ruang IT KPB</td>
                </tr>
                <tr>
                    <td class="label">Tujuan</td>
                    <td class="separator">:</td>
                    <td class="value">@Model.Tujuan</td>
                </tr>
            </table>
        </div>

        <div class="title">@(Model.JenisSurat?.NamaJenis?.ToUpper())</div>
        <div class="subtitle">Nomor: @Model.NomorSurat</div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Deskripsi))
        {
            <div class="deskripsi">@Model.Deskripsi</div>
        }

        @if (Model.PoinList != null && Model.PoinList.Any())
        {
            foreach (var poin in Model.PoinList)
            {
                var lv = Math.Clamp(poin.Level, 0, 2);
                var no = NomorPoin(lv);

                <div class="poin poin-@lv">
                    <div class="poin-judul"><span class="no">@no</span>@poin.Judul</div>

                    @if (!string.IsNullOrWhiteSpace(poin.Keterangan))
                    {
                        <div class="poin-ket">@poin.Keterangan</div>
                    }

                    @if (poin.Gambar != null && poin.Gambar.Any())
                    {
                        <div class="poin-gambar">
                            @foreach (var g in poin.Gambar)
                            {
                                <img src="@Url.Content("~" + g.FilePath)" alt="Lampiran @no" />
                            }
                        </div>
                    }
                </div>
            }
        }

        <div class="penutup">
            Demikian berita acara ini dibuat dengan sebenar-benarnya untuk dapat
            dipergunakan sebagaimana mestinya.
        </div>

        @* Survey tidak mendata penanggung jawab, jadi tidak memintanya
           bertanda tangan — dua kotak, bukan tiga. *@
        <table class="signature @(survey ? "signature--dua" : "")">
            @* Jabatan di bawah tiap peran. Staff dan Manager dari tabel Users,
               penanggung jawab dari Surat.Jabatan yang diketik di formulir. *@
            <tr>
                <td>
                    Dibuat oleh
                    @if (!string.IsNullOrWhiteSpace(Model.Staff?.Jabatan))
                    {
                        <br />@Model.Staff.Jabatan
                    }
                </td>
                @* Pada Survey kotak ini yang paling kanan, jadi tempat dan tanggalnya
                   di sini; pada Kerusakan ada satu kotak lagi sesudahnya. *@
                <td>
                    @if (survey)
                    {
                        <text><span class="tanggal-ttd">Balikpapan, @Model.Tanggal.ToString("dd MMMM yyyy")</span><br /></text>
                    }
                    Mengetahui<br />@(string.IsNullOrWhiteSpace(Model.Manager?.Jabatan) ? "Ast. Manajer IT | KPB" : Model.Manager.Jabatan)
                </td>
                @if (!survey)
                {
                    <td>
                        <span class="tanggal-ttd">Balikpapan, @Model.Tanggal.ToString("dd MMMM yyyy")</span><br />
                        Penanggung Jawab
                        @if (!string.IsNullOrWhiteSpace(Model.Jabatan))
                        {
                            <br />@Model.Jabatan
                        }
                    </td>
                }
            </tr>
            <tr>
                <td class="ruang"></td>
                <td class="ruang"></td>
                @if (!survey)
                {
                    <td class="ruang"></td>
                }
            </tr>
            <tr>
                <td class="signature-name">@Model.Staff?.Nama</td>
                <td class="signature-name">@Model.Manager?.Nama</td>
                @if (!survey)
                {
                    <td class="signature-name">@Model.NamaPenanggungJawab</td>
                }
            </tr>
        </table>

    </div>
</div>

</body>
</html>
