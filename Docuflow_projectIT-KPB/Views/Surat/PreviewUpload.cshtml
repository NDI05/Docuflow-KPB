@{
    ViewData["Title"] = "Preview Surat";
}

<h2>Preview Surat</h2>

<hr />

<p><b>File:</b> @ViewBag.FileName</p>

<iframe src="@ViewBag.FilePath" width="100%" height="500px"></iframe>

<hr />

<form asp-action="SavePreview" method="post">

    <input type="hidden" name="filePath" value="@ViewBag.FilePath" />

    <div class="mb-3">
        <label>Jenis Surat</label>
        <select name="JenisSuratId" class="form-control">

            @foreach (var j in ViewBag.JenisSurat)
            {
                <option value="@j.Id">@j.Nama</option>
            }

        </select>
    </div>

    <div class="mb-3">
        <label>Staff</label>
        <select name="StaffId" class="form-control">

            <option value="">-- pilih staff --</option>

            @foreach (var u in ViewBag.Users)
            {
                if (u.Role == "Staff")
                {
                    <option value="@u.Id">@u.Nama</option>
                }
            }

        </select>
    </div>

    <div class="mb-3">
        <label>Manager</label>
        <select name="ManagerId" class="form-control">

            <option value="">-- pilih manager --</option>

            @foreach (var u in ViewBag.Users)
            {
                if (u.Role == "Manager")
                {
                    <option value="@u.Id">@u.Nama</option>
                }
            }

        </select>
    </div>

    <button type="submit" class="btn btn-success">
        Simpan Surat
    </button>

</form>