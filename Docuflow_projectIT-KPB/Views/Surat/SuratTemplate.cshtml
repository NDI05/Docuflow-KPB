@using Docuflow_projectIT_KPB.Services
@model Docuflow_projectIT_KPB.Models.Surat
@{
    Layout = null;

    // Ditandai GeneratePdf. Lihat blok hiasan layar di bawah.
    var cetak = ViewData["Cetak"] as bool? == true;

    // Dua jenis berbagi kode BAST. Serah terima rekaman CCTV memakai kolom
    // dan kotak tanda tangan sendiri; aturannya dijawab Bast, sumber yang
    // sama dengan yang dipakai formulir Create supaya kolom di layar tidak
    // pernah berbeda dengan kolom di kertas.
    var cctv = Bast.Cctv(Model.JenisSurat?.NamaJenis);
    var jumlahKolom = cctv ? 6 : 5;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Preview Surat</title>

    <style>
            /* Margin nol: jarak tepi yang sebenarnya adalah padding
               .page-content. Kalau @@page juga diberi margin, keduanya
               bertumpuk dan isi halaman menyusut jadi kotak kecil di tengah. */
            @@page {
                size: A4;
                margin: 0;
            }

            /* Arial, gaya formal, spacing normal.
               line-height diseragamkan 1.5 di sini; sebelumnya tiap blok
               memakai angka sendiri (1.2 / 1.4 / 1.5 / 1.55) sehingga jarak
               baris antar bagian tidak konsisten di satu halaman. */
            body {
                margin: 0;
                padding: 0;
                font-family: Arial, Helvetica, sans-serif;
                font-size: 12px;
                line-height: 1.5;
                color: #000;
                background: #fff;
            }

            /* Persis satu lembar A4, tanpa jarak dan tanpa bayangan.
               Keduanya ditambahkan kembali hanya untuk layar. */
            .paper {
                width: 210mm;
                min-height: 297mm;
                margin: 0 auto;
                background: #fff;
                padding: 0;
                box-sizing: border-box;
            }

            .page-content {
                padding: 20mm 18mm 20mm 18mm;
                box-sizing: border-box;
            }

            .page-break {
                page-break-after: always;
            }

            /* min-height harus menampung kotak nomor yang diposisikan absolut —
               kotak itu tidak ikut mendorong tinggi header, jadi kalau kurang,
               judul di bawahnya tertimpa. */
            .header {
                position: relative;
                min-height: 112px;
                margin-bottom: 15px;
            }

            /* 105px, bukan 90px seperti logo lama: berkas ini punya ruang
               kosong bawaan di kiri-kanan, jadi tanda logonya perlu sedikit
               lebih lebar supaya tercetak sebesar sebelumnya. */
            .logo {
                position: absolute;
                top: 0;
                left: 0;
                width: 115px;
            }

            .header-center {
                text-align: center;
                padding-top: 5px;
                margin-left: 120px;
                margin-right: 288px;
            }

            .company {
                font-size: 16px;
                font-weight: bold;
                line-height: 1.2;
            }

            .company-sub {
                font-size: 16px;
                font-weight: bold;
                margin-top: 2px;
            }

            .alamat {
                margin-top: 6px;
                font-size: 11px;
                line-height: 1.4;
            }

            /* 278px, bukan 245px: nomor ("BAST 002/KPB3240/2026-S0") pernah
               membungkus ke baris kedua pada lebar lama, membuat kotak ini
               memanjang ke bawah sampai menabrak judul. Lebar ini disisakan
               meski format kehilangan "No." — ruangnya untuk kode terpanjang. */
            .box-info {
                position: absolute;
                top: 0;
                right: 0;
                width: 278px;
                border: 1px solid #000;
                border-collapse: collapse;
                font-size: 11px;
            }

                .box-info td {
                    border-bottom: 1px solid #000;
                    padding: 4px 6px;
                    vertical-align: top;
                }

                .box-info tr:last-child td {
                    border-bottom: none;
                }

                .box-info .label {
                    width: 52px;
                    white-space: nowrap;
                }

                .box-info .separator {
                    width: 10px;
                    text-align: center;
                }

                .box-info .value {
                    font-weight: bold;
                }

            .title {
                text-align: center;
                font-size: 14px;
                font-weight: bold;
                text-decoration: underline;
                margin: 10px 0 15px 0;
            }

            .info-table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 12px;
                font-size: 12px;
            }

                .info-table td {
                    padding: 2px 0;
                    vertical-align: top;
                }

                .info-table .label {
                    width: 190px;
                }

                .info-table .colon {
                    width: 12px;
                    text-align: center;
                }

                .info-table .value {
                    width: 260px;
                }

            /* ================= TABEL BARANG ================= */
            .barang-table {
                width: 100%;
                border-collapse: collapse;
                margin-top: 8px;
                font-size: 11px;
            }

                .barang-table th,
                .barang-table td {
                    border: 1px solid #000;
                    padding: 6px 6px;
                }

                .barang-table th {
                    text-align: center;
                    background: #f3f3f3;
                    font-weight: bold;
                }

                .barang-table tfoot td {
                    font-weight: bold;
                    text-align: left;
                    padding: 8px 8px;
                }

            .text-left {
                text-align: left;
            }

            .text-center {
                text-align: center;
            }

            .paragraph {
                margin-top: 8px;
                text-align: justify;
                line-height: 1.5;
                font-size: 11.5px;
            }

            .signature {
                width: 100%;
                border-collapse: collapse;
                margin-top: 22px;
                font-size: 11px;
            }

                .signature td {
                    text-align: center;
                    vertical-align: top;
                    width: 25%;
                    padding: 0 5px;
                }

                /* Tiga kotak harus tetap memenuhi lebar halaman; 25% akan
                   menyisakan seperempat kosong di kanan. */
                .signature--tiga td {
                    width: 33.33%;
                }

            .sign-space {
                height: 65px;
            }

            .signature-name {
                font-weight: bold;
                text-decoration: underline;
            }

            .page2-title {
                text-align: center;
                font-size: 14px;
                font-weight: bold;
                margin-bottom: 6px;
            }

            .page2-subtitle {
                text-align: center;
                font-size: 11px;
                font-weight: bold;
                margin-bottom: 15px;
            }

            .rules {
                font-size: 11px;
                line-height: 1.55;
                text-align: justify;
            }

                .rules ol {
                    padding-left: 18px;
                    margin: 0;
                }

                .rules li {
                    margin-bottom: 8px;
                }

                .rules .sublist {
                    margin-top: 6px;
                    padding-left: 18px;
                }

                    .rules .sublist li {
                        margin-bottom: 5px;
                    }
    </style>
@if (!cetak)
{
    @* Hiasan layar — latar abu, bayangan, dan jarak di sekeliling kertas —
       hanya untuk pratinjau di peramban. Ditulis di sini, bukan di blok CSS
       utama, karena tiga hal itu ikut TERCETAK kalau tidak dipisahkan:
       latar abu jadi bidang abu di seluruh halaman, bayangan jadi garis
       kelabu di tepi, dan margin luar menggeser kertas sehingga isinya
       mengecil — hasilnya mirip hasil pindai, bukan dokumen.

       Dua penjaga, masing-masing menutup satu jalur cetak yang berbeda:
       blok ini tidak dirender sama sekali saat wkhtmltopdf yang memanggil,
       dan @@media screen menjaga Ctrl+P dari halaman pratinjau. *@
    <style>
        @@media screen {
            body { background: #f2f2f2; }
            .paper { margin: 15px auto; box-shadow: 0 0 10px rgba(0,0,0,0.15); }
        }
    </style>
}
</head>

<body>

    <!-- ================= PAGE 1 ================= -->
    <div class="paper page-break">
        <div class="page-content">

            <div class="header">

                @* Logo resmi Kilang Pertamina Balikpapan. Berkas lama
                   (Logo_pertamina.png) memakai merah/biru/hijau RGB murni,
                   bukan warna merek — jangan dipakai lagi. *@
                <img src="@Url.Content("~/images/kpb-logo.png")" class="logo" alt="Kilang Pertamina Balikpapan" />

                <div class="header-center">
                    <div class="company">PT KILANG PERTAMINA</div>
                    <div class="company-sub">BALIKPAPAN</div>

                    <div class="alamat">
                        Kantor NSO PT Kilang Pertamina Balikpapan<br />
                        JL. Yos Sudarso No.1 Balikpapan
                    </div>
                </div>

                <table class="box-info">
                    <tr>
                        <td class="label">Nomor</td>
                        <td class="separator">:</td>
                        <td class="value">@Model.NomorSurat</td>
                    </tr>
                    <tr>
                        <td class="label">Tanggal</td>
                        <td class="separator">:</td>
                        <td class="value">@Model.Tanggal.ToString("dd MMMM yyyy")</td>
                    </tr>
                    <tr>
                        <td class="label">Dari</td>
                        <td class="separator">:</td>
                        <td class="value">Ruang IT KPB</td>
                    </tr>
                    @* Baris ini SELALU dicetak, termasuk saat isinya kosong: bentuk
                       kop BAST memang memuat Tujuan, dan menghilangkan barisnya
                       mengubah bentuk dokumennya. Arsip 2026 memang tidak menyimpan
                       tujuan, jadi yang tercetak "Tujuan :" tanpa isi. *@
                    <tr>
                        <td class="label">Tujuan</td>
                        <td class="separator">:</td>
                        <td class="value">@Model.Tujuan</td>
                    </tr>
                </table>

            </div>

            <div class="title">
                @(Model.JenisSurat?.NamaJenis?.ToUpper())
            </div>

            <table class="info-table">
                <tr>
                    <td class="label"><b>Nama Penanggung Jawab</b></td>
                    <td class="colon">:</td>
                    <td class="value">@Model.NamaPenanggungJawab</td>

                    <td class="label" style="width:110px;"><b>No. Pekerja</b></td>
                    <td class="colon">:</td>
                    <td>@Model.NoPekerja</td>
                </tr>

                <tr>
                    <td class="label"><b>Jabatan</b></td>
                    <td class="colon">:</td>
                    <td class="value">@Model.Jabatan</td>
                </tr>

                <tr>
                    <td class="label"><b>Fungsi/Direktorat</b></td>
                    <td class="colon">:</td>
                    <td class="value">@Model.FungsiDirektorat</td>
                    <td></td>
                    <td></td>
                    <td></td>
                </tr>

                <tr>
                    <td class="label"><b>Alamat</b></td>
                    <td class="colon">:</td>
                    <td class="value">@Model.Alamat</td>
                </tr>
            </table>

            <!-- ================= TABEL BARANG + CATATAN DALAM TABEL ================= -->
            <table class="barang-table">
                <thead>
                    <tr>
                        <th width="40">No</th>
                        <th>Nama Barang</th>
                        @if (cctv)
                        {
                            <th width="120">Tanggal</th>
                            <th width="105">Jam</th>
                            <th width="145">Rekaman</th>
                            <th width="110">Area</th>
                        }
                        else
                        {
                            <th width="150">Serial Number</th>
                            <th width="140">Merk Type</th>
                            <th width="140">Pengguna</th>
                        }
                    </tr>
                </thead>

                <tbody>
                    @if (Model.BarangList != null && Model.BarangList.Any())
                    {
                        int no = 1;
                        foreach (var barang in Model.BarangList)
                        {
                            <tr>
                                <td class="text-center">@no</td>
                                <td class="text-left">@barang.NamaBarang</td>
                                @if (cctv)
                                {
                                    <td class="text-center">@barang.Tanggal</td>
                                    <td class="text-center">@barang.Jam</td>
                                    <td class="text-center">@barang.Rekaman</td>
                                    <td class="text-center">@barang.Area</td>
                                }
                                else
                                {
                                    <td class="text-center">@barang.SerialNumber</td>
                                    <td class="text-center">@barang.MerkType</td>
                                    <td class="text-center">@barang.Pengguna</td>
                                }
                            </tr>
                            no++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="@jumlahKolom" class="text-center">Tidak ada data barang</td>
                        </tr>
                    }
                </tbody>

                <!-- CATATAN MASUK TABEL -->
                <tfoot>
                    <tr>
                        <td colspan="@jumlahKolom">
                            @* "No" hanya ditambahkan kalau dasarnya belum menyebut
                               nomor sendiri. Tanpa ini pilihan "Nomor Memo" tercetak
                               sebagai "Nomor Memo No 123", yang menyebut nomor dua kali. *@
                            @{
                                var dasar = (Model.JenisTiket ?? string.Empty).Trim();
                                var noTiket = (Model.NoTiket ?? string.Empty).Trim();
                                var sebutNomor = dasar.StartsWith("Nomor", StringComparison.OrdinalIgnoreCase);
                                var adaDasar = dasar.Length > 0 || noTiket.Length > 0;
                            }
                            @* Kalimat "Berdasarkan ... No ..." hanya dicetak kalau memang ada
                               dasarnya. Dokumen arsip lama tidak menyimpan rujukan tiket, dan
                               tanpa syarat ini seluruhnya tercetak "Berdasarkan  No " —
                               kalimat menggantung yang tampak seperti data hilang. *@
                            @if (adaDasar)
                            {
                                <text>Catatan : Pemenuhan Permintaan Berdasarkan @dasar @(sebutNomor ? "" : "No") @noTiket</text>
                            }
                            else
                            {
                                <text>Catatan :</text>
                            }
                        </td>
                    </tr>
                </tfoot>
            </table>

            <div class="paragraph">
                I. Telah dilakukan uji-coba terhadap barang yang diserahkan sesuai dengan data diatas,
                yang dilaksanakan oleh petugas dari staff IT KPB dan pihak penerima sebagai pemakai /
                penanggung jawab, semua sepakat bahwa barang tersebut telah sesuai seperti tercantum
                di atas dan bekerja dengan baik serta laik pakai.
            </div>

            <div class="paragraph">
                II. Pihak penerima bertanggung jawab sepenuhnya atas barang yang digunakan dan telah
                membaca serta setuju dengan ketentuan tambahan yang tercantum pada halaman belakang
                dari lembar bukti penerimaan barang ini (wajib dibaca).
            </div>

            <div class="paragraph">
                III. Apabila terjadi pencurian / kehilangan barang yang diserahkan kepada pemakai /
                penanggung jawab, maka pemakai / penanggung jawab harus melaporkan kepada Kepolisian
                dan Sekuriti Pertamina dimana terjadi kehilangan barang tersebut.
            </div>

            <div class="paragraph">
                IV. Perangkat IT yang tidak harus / wajib dikembalikan ke Fungsi IT KPB Direktorat
                Keuangan apabila pekerja mutasi / keluar.
            </div>

            <div class="paragraph">
                V. Kami sebagai Penerima/Penanggung Jawab telah membaca, memahami dan menerima
                semua ketentuan Perusahaan tersebut.
            </div>

            @* Serah terima rekaman CCTV tidak punya penanggung jawab perangkat,
               jadi kotaknya tiga: penyerah, yang mengetahui, penerima.        *@
            <table class="signature @(cctv ? "signature--tiga" : "")">
                @* Setiap kotak menyebut jabatan tepat di bawah perannya.
                   Sumbernya berbeda-beda dan itu disengaja:
                     Staff dan Manager  -> kolom Jabatan miliknya di tabel Users
                     Penanggung jawab   -> Surat.Jabatan, diketik di formulir
                                           karena ia umumnya bukan pengguna aplikasi
                     Yang menerima      -> tidak ada sumbernya, jadi dikosongkan
                   Jabatan yang belum diisi tidak mencetak baris kosong. *@
                <tr>
                    <td>
                        Yang Menyerahkan
                        @if (!string.IsNullOrWhiteSpace(Model.Staff?.Jabatan))
                        {
                            <br />@Model.Staff.Jabatan
                        }
                    </td>
                    <td>Mengetahui<br />@(string.IsNullOrWhiteSpace(Model.Manager?.Jabatan) ? "Ast. Manajer IT | KPB" : Model.Manager.Jabatan)</td>
                    @if (!cctv)
                    {
                        <td>
                            Yang Bertanggung Jawab
                            @if (!string.IsNullOrWhiteSpace(Model.Jabatan))
                            {
                                <br />@Model.Jabatan
                            }
                        </td>
                    }
                    @* Bulan ditulis penuh, bukan "07.09.2026": bentuk baku surat resmi
                       Indonesia. Culture aplikasi id-ID (Program.cs) yang menerjemahkan
                       MMMM, jadi nama bulannya tidak perlu ditulis tangan. *@
                    <td>
                        Balikpapan, @Model.Tanggal.ToString("dd MMMM yyyy")<br />
                        Yang Menerima
                        @if (!string.IsNullOrWhiteSpace(Model.JabatanYangMenerima))
                        {
                            <br />@Model.JabatanYangMenerima
                        }
                    </td>
                </tr>

                <tr>
                    <td class="sign-space"></td>
                    <td class="sign-space"></td>
                    @if (!cctv)
                    {
                        <td class="sign-space"></td>
                    }
                    <td class="sign-space"></td>
                </tr>

                <tr>
                    <td class="signature-name">@Model.Staff?.Nama</td>
                    <td class="signature-name">@Model.Manager?.Nama</td>
                    @if (!cctv)
                    {
                        <td class="signature-name">@Model.NamaPenanggungJawab</td>
                    }
                    <td class="signature-name">@Model.YangMenerima</td>
                </tr>
            </table>

        </div>
    </div>

    <!-- ================= PAGE 2 ================= -->
    <div class="paper">
        <div class="page-content">

            <div class="page2-title">PT. KILANG PERTAMINA BALIKPAPAN</div>
            <div class="page2-subtitle">
                PETUNJUK / KETENTUAN PEMAKAIAN<br />
                PERANGKAT IT
            </div>

            <div class="rules">
                <ol>
                    <li>
                        Perangkat IT (PC/Notebook/iPod/Printer/Scanner), dll yang diserahkan/dititipkan adalah perangkat yang
                        semata-mata digunakan untuk kepentingan dinas / perusahaan, dan karenanya harus dipelihara dan
                        dipergunakan sebaik-baiknya sesuai petunjuk dan aturan yang berlaku.
                    </li>

                    <li>
                        Penerima/Penanggung jawab bertanggung jawab penuh atas pemeliharaan barang yang diserahkan kepada
                        Penerima/Penanggung Jawab, termasuk namun tidak terbatas untuk bertanggung jawab atas kehilangan
                        Sebagian atau keseluruhan peralatan yang telah diterima, sampai dengan berakhirnya masa pemakaian.
                        Kehilangan di luar lokasi kerja dan kerusakan yang diakibatkan kesalahan dan/atau kelalaian Penerima/
                        Penanggung Jawab, serta hal-hal lainnya menjadi tanggung jawab sepenuhnya Penerima/Penanggung Jawab.
                    </li>

                    <li>
                        Kesalahan pemakai / kelalaian penerima/penanggung jawab dalam memelihara barang sebagaimana diwajibkan
                        menurut angka 2 diatas, merupakan pelanggaran Pasal 289-291-302, sehingga berakibat pemecatan secara
                        sepihak dan/atau mewajibkan kepada Penerima/Penanggung Jawab untuk melakukan penggantian dan/atau
                        penggantian kerugian sesuai ketentuan yang berlaku.
                    </li>

                    <li>
                        Penerima/Penanggung Jawab untuk mengembalikan / menyerahkan perangkat selengkapnya kepada Deskbook yang
                        diserahkan baik sebagai pemakai keseluruhan. Khususnya bagi pengembalian barang yang terjadi untuk
                        memenuhi kebutuhan lain, perangkat tersebut harus kembali lengkap seperti semula. Apabila ditemukan
                        perangkat lunak ilegal pada perangkat Deskbook menjadi tanggung jawab dari Penerima/Penanggung Jawab,
                        dan Fungsi Corporate Shared Service berhak melakukan penghapusan terhadap perangkat lunak ilegal tersebut.
                    </li>

                    <li>
                        Segala kerusakan yang diakibatkan oleh kesalahan operasi atau pemakaian yang tidak sesuai atau akibat
                        dari pemasangan perangkat lunak ilegal menjadi tanggung jawab Penerima/Penanggung Jawab.
                    </li>

                    <li>
                        Untuk pencegahan kehilangan file/dokumen/data yang dikarenakan:
                        <ol class="sublist" type="a">
                            <li>Virus, disarankan tidak melakukan pembacaan eksternal data sebelum dilakukan pemeriksaan dengan antivirus.</li>
                            <li>Kerusakan perangkat/hardisk, disarankan secara rutin melakukan back-up terhadap file/dokumen/data.</li>
                        </ol>
                    </li>

                    <li>
                        Segala informasi yang tersimpan didalam perangkat desktop sepenuhnya merupakan milik perusahaan dan
                        kehilangan segala informasi yang terdapat pada perangkat desktop menjadi tanggung jawab dari Penerima/
                        Penanggung Jawab, untuk menjaga keamanan informasi dalam perangkat tersebut, dianjurkan untuk:
                        <ol class="sublist" type="a">
                            <li>Melakukan Enkripsi Data</li>
                            <li>Menggunakan Folder Sharing Resmi dari Pertamina dalam menyimpan data-data penting perusahaan</li>
                        </ol>
                    </li>

                    <li>
                        Untuk kepentingan Perusahaan, segala informasi yang terdapat pada Perangkat Desktop yang diklasasikan
                        sebagai rahasia kepada pekerja, sepenuhnya dapat diakses oleh perusahaan.
                    </li>

                    <li>
                        Segala kegiatan yang dilakukan Penerima/Penanggung Jawab menggunakan perangkat Desktop harus menggunakan
                        UID masing-masing pengguna, dan UID tersebut tidak boleh serta dengan Local Administrator, maka Fungsi
                        Corporate Shared Service berhak melakukan pencabutan otorisasi local Administrator pada UID tersebut.
                    </li>

                    <li>
                        Untuk penerima/Penanggung Jawab yang menggunakan e-mail, harap diperhatikan untuk tidak membuka e-mail
                        dari pengirim yang tidak dikenal (khususnya yang ada attachment-nya), e-mail yang subjectnya tidak jelas,
                        dan sebagainya. E-mail tersebut sebaiknya segera didelete.
                    </li>

                    <li>
                        Perangkat Desktop yang dialokasikan harus/wajib dikembalikan kepada Fungsi Corporate Shared Service
                        Direktorat Keuangan dalam hal:
                        <ol class="sublist" type="a">
                            <li>Telah berakhirnya masa sewanya (Fungsi Corporate Shared Service akan memberitahukan 1 bulan sebelum masa sewa berakhir).</li>
                            <li>Pemakai tidak memerlukan lagi.</li>
                            <li>Terjadi mutasi terhadap pemakai/penanggung jawab Perangkat Desktop.</li>
                            <li>Fungsi Corporate CSS memandang perlu (dengan alasan tertentu) untuk lebih mendayagunakan Perangkat Desktop yang bersangkutan.</li>
                        </ol>
                    </li>

                    <li>
                        Untuk informasi lebih lanjut, bantuan (support), keluhan yang berhubungan dengan kurang optimalnya maupun dugaan terjadinya kerusakan Perangkat Desktop yang dialokasikan, harap menghubungi Service Desk, telp ext 6666, e-mail: it.
                    </li>

                    <li>
                        Dengan telah membaca ketentuan ini, Penerima/Penanggung Jawab telah memahami isi petunjuk/ketentuan dan
                        berjanji akan melaksanakan seluruh kewajiban serta akan menerima segala konsekuensi yang dibebankan sesuai
                        kesepakatan ini, termasuk namun tidak terbatas pada pemotongan upah untuk penyelesaian ganti kerugian apabila
                        dibebankan kepada Penerima/Penanggung Jawab.
                    </li>
                </ol>
            </div>

        </div>
    </div>

