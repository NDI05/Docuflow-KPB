@model Docuflow_projectIT_KPB.Models.Surat

@{
    ViewData["Title"] = "Buat Surat";
}

<div class="kpb-head">
    <div>
        <h1>Buat Surat</h1>
        <p>Nomor surat dibuat otomatis setelah disimpan.</p>
    </div>

    <div class="kpb-head-actions">
        <a asp-action="Index" class="btn btn-ghost-ink btn-sm">Batal</a>
        <button type="submit" form="formSurat" class="btn btn-on-ink btn-sm">Simpan Surat</button>
    </div>
</div>

<div class="kpb-panel-body">

    <form asp-action="Create" method="post" id="formSurat">

        <div class="kpb-field-group">
            <div class="kpb-section">
                <div class="kpb-mark" aria-hidden="true"><span></span><span></span><span></span></div>
                <h2>Jenis Surat &amp; Tujuan</h2>
                <div class="kpb-rule"></div>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" asp-for="JenisSuratId">Jenis Surat</label>
                    <select asp-for="JenisSuratId" class="form-select" required>
                        <option value="">Pilih jenis surat</option>
                        @foreach (var j in ViewBag.JenisSurat)
                        {
                            <option value="@j.Id">@j.NamaJenis</option>
                        }
                    </select>
                    <span asp-validation-for="JenisSuratId" class="text-danger"></span>
                </div>

                <div class="col-md-6">
                    <label class="form-label" asp-for="Tujuan">Tujuan</label>
                    <input asp-for="Tujuan" class="form-control" placeholder="Contoh: Fungsi Reliability" required />
                    <span asp-validation-for="Tujuan" class="text-danger"></span>
                </div>
            </div>
        </div>

        <div class="kpb-field-group">
            <div class="kpb-section">
                <div class="kpb-mark" aria-hidden="true"><span></span><span></span><span></span></div>
                <h2>Penanggung Jawab</h2>
                <div class="kpb-rule"></div>
            </div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" asp-for="NamaPenanggungJawab">Nama</label>
                    <input asp-for="NamaPenanggungJawab" class="form-control" />
                </div>

                <div class="col-md-4">
                    <label class="form-label" asp-for="Jabatan">Jabatan</label>
                    <input asp-for="Jabatan" class="form-control" />
                </div>

                <div class="col-md-4">
                    <label class="form-label" asp-for="FungsiDirektorat">Fungsi / Direktorat</label>
                    <input asp-for="FungsiDirektorat" class="form-control" />
                </div>

                <div class="col-md-4">
                    <label class="form-label" asp-for="NoPekerja">Nomor Pekerja</label>
                    <input asp-for="NoPekerja" class="form-control" />
                </div>

                <div class="col-md-8">
                    <label class="form-label" asp-for="Alamat">Alamat</label>
                    <textarea asp-for="Alamat" class="form-control" rows="2"></textarea>
                </div>
            </div>
        </div>

        <div class="kpb-field-group">
            <div class="kpb-section">
                <div class="kpb-mark" aria-hidden="true"><span></span><span></span><span></span></div>
                <h2>Daftar Barang</h2>
                <div class="kpb-rule"></div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-4">
                    <label class="form-label" for="deviceType">Isi cepat dari jenis perangkat</label>
                    <select id="deviceType" class="form-select">
                        <option value="">Pilih untuk mengisi baris otomatis</option>
                        <option value="PC">PC</option>
                        <option value="Laptop">Laptop</option>
                        <option value="HT">HT</option>
                        <option value="Lainnya">Lainnya</option>
                    </select>
                </div>
            </div>

            <div class="kpb-table-wrap">
                <table class="kpb-table is-editable" id="barangTable">
                    <thead>
                        <tr>
                            <th style="width:52px;">No</th>
                            <th>Nama Barang</th>
                            <th>Serial Number</th>
                            <th>Merk / Tipe</th>
                            <th>Pengguna</th>
                            <th class="is-center" style="width:64px;">Hapus</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>

            <button type="button" id="addRow" class="btn btn-outline-ink btn-sm mt-3">
                <i class="bi bi-plus-lg"></i> Tambah Baris
            </button>
        </div>

        <div class="kpb-field-group">
            <div class="kpb-section">
                <div class="kpb-mark" aria-hidden="true"><span></span><span></span><span></span></div>
                <h2>Dasar Pemenuhan</h2>
                <div class="kpb-rule"></div>
            </div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" asp-for="JenisTiket">Jenis Tiket</label>
                    <select asp-for="JenisTiket" class="form-select">
                        <option value="Tiket MySSC">Tiket MySSC</option>
                        <option value="Tiket BAST">Tiket BAST</option>
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label" asp-for="NoTiket">Nomor Tiket</label>
                    <input asp-for="NoTiket" class="form-control" />
                </div>
            </div>
        </div>

        <div class="kpb-field-group">
            <div class="kpb-section">
                <div class="kpb-mark" aria-hidden="true"><span></span><span></span><span></span></div>
                <h2>Tanda Tangan</h2>
                <div class="kpb-rule"></div>
            </div>

            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" asp-for="StaffId">Staff</label>
                    <select asp-for="StaffId" class="form-select">
                        <option value="">Pilih staff</option>
                        @foreach (var user in ViewBag.Users)
                        {
                            if (user.Role == "Staff")
                            {
                                <option value="@user.Id">@user.Nama</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label" asp-for="ManagerId">Manager</label>
                    <select asp-for="ManagerId" class="form-select">
                        <option value="">Pilih manager</option>
                        @foreach (var user in ViewBag.Users)
                        {
                            if (user.Role == "Manager")
                            {
                                <option value="@user.Id">@user.Nama</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-4">
                    <label class="form-label" asp-for="YangMenerima">Yang Menerima</label>
                    <input asp-for="YangMenerima" class="form-control" />
                </div>
            </div>
        </div>

    </form>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        let rowNumber = 0;

        const templates = {
            "PC": ["PC", "Monitor", "VGA", "Keyboard", "Mouse", "Hostname"],
            "Laptop": ["Notebook", "Adaptor", "Backpack", "Mouse", "Ethernet", "Chainlock", "Hostname"],
            "HT": ["HT", "Charger", "Battery", "Antenna"]
        };

        function addRow(nama = "") {
            rowNumber++;

            $("#barangTable tbody").append(`
                <tr>
                    <td class="is-center">${rowNumber}</td>
                    <td><input name="NamaBarang[]" class="form-control" value="${nama}" /></td>
                    <td><input name="SerialNumber[]" class="form-control" /></td>
                    <td><input name="MerkType[]" class="form-control" /></td>
                    <td><input name="Pengguna[]" class="form-control" /></td>
                    <td class="is-center">
                        <button type="button" class="btn btn-outline-danger btn-sm removeRow" aria-label="Hapus baris">
                            <i class="bi bi-x-lg"></i>
                        </button>
                    </td>
                </tr>
            `);
        }

        $("#deviceType").change(function () {
            let val = $(this).val();
            $("#barangTable tbody").empty();
            rowNumber = 0;

            if (templates[val]) {
                templates[val].forEach(x => addRow(x));
            } else {
                addRow("");
            }
        });

        $("#addRow").click(() => addRow(""));

        $(document).on("click", ".removeRow", function () {
            $(this).closest("tr").remove();

            rowNumber = 0;
            $("#barangTable tbody tr").each(function () {
                rowNumber++;
                $(this).find("td:first").text(rowNumber);
            });
        });

        // Open with one row — a header with no body reads as a broken table.
        addRow("");
    </script>
}
