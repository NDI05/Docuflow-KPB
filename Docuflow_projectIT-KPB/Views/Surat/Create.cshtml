@model Docuflow_projectIT_KPB.Models.Surat

@{
    ViewData["Title"] = "Buat Surat";
}

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/css/select2.min.css" rel="stylesheet" />

<style>
    .page-card {
        border-radius: 18px;
        overflow: hidden;
        border: none;
        box-shadow: 0px 10px 25px rgba(0,0,0,0.10);
    }

    .page-header {
        background: #c6c8d9;
        padding: 14px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .form-wrapper {
        background: #f4f6fb;
        padding: 20px;
    }

    .section-box {
        background: #dcdfee;
        border-radius: 14px;
        padding: 12px;
        margin-bottom: 16px;
    }

    .section-title {
        background: #bfc2d9;
        padding: 8px 12px;
        border-radius: 10px;
        font-weight: 800;
        margin-bottom: 12px;
    }

    .form-control {
        border-radius: 10px !important;
        height: 38px;
    }

    textarea.form-control {
        height: auto !important;
    }

    .table-custom {
        background: white;
        border-radius: 12px;
        overflow: hidden;
    }

        .table-custom thead {
            background: #c6c8d9;
            text-align: center;
        }

    .btn-add {
        border-radius: 10px;
        font-weight: 700;
        padding: 7px 12px;
    }
</style>

<div class="card page-card">

    <div class="page-header">
        <h5>Buat Surat</h5>
        <button type="submit" form="formSurat" class="btn btn-success">Simpan</button>
    </div>

    <div class="form-wrapper">

        <!-- ❌ enctype multipart dihapus karena tidak ada upload -->
        <form asp-action="Create" method="post" id="formSurat">

            <!-- JENIS SURAT + TUJUAN -->
            <div class="section-box">
                <div class="section-title">Jenis Surat & Tujuan</div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label>Jenis Surat</label>
                        <select asp-for="JenisSuratId" class="form-control" required>
                            <option value="">-- Pilih Jenis Surat --</option>
                            @foreach (var j in ViewBag.JenisSurat)
                            {
                                <option value="@j.Id">@j.NamaJenis</option>
                            }
                        </select>
                        <span asp-validation-for="JenisSuratId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label>Tujuan</label>
                        <input asp-for="Tujuan" class="form-control" placeholder="Masukkan tujuan surat" required />
                        <span asp-validation-for="Tujuan" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <!-- PENANGGUNG JAWAB -->
            <div class="section-box">
                <div class="section-title">Data Penanggung Jawab</div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label>Nama</label>
                        <input asp-for="NamaPenanggungJawab" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label>Jabatan</label>
                        <input asp-for="Jabatan" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label>Fungsi/Direktorat</label>
                        <input asp-for="FungsiDirektorat" class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label>No Pekerja</label>
                        <input asp-for="NoPekerja" class="form-control" />
                    </div>

                    <div class="col-md-8">
                        <label>Alamat</label>
                        <textarea asp-for="Alamat" class="form-control"></textarea>
                    </div>
                </div>
            </div>

            <!-- DEVICE -->
            <div class="section-box">
                <div class="section-title">Jenis Perangkat</div>

                <select id="deviceType" class="form-control">
                    <option value="">-- Pilih --</option>
                    <option value="PC">PC</option>
                    <option value="Laptop">Laptop</option>
                    <option value="HT">HT</option>
                    <option value="Lainnya">Lainnya</option>
                </select>
            </div>

            <!-- TABEL -->
            <div class="section-box">
                <div class="section-title">Daftar Barang</div>

                <div class="table-responsive table-custom">
                    <table class="table table-bordered" id="barangTable">
                        <thead>
                            <tr>
                                <th>No</th>
                                <th>Nama Barang</th>
                                <th>Serial Number</th>
                                <th>Merk</th>
                                <th>Pengguna</th>
                                <th>Aksi</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>

                <button type="button" id="addRow" class="btn btn-primary btn-add mt-3">
                    + Tambah Manual
                </button>
            </div>

            <!-- CATATAN -->
            <div class="section-box">
                <div class="section-title">Catatan</div>

                <div class="d-flex gap-2 align-items-center flex-wrap">
                    <span>Pemenuhan Berdasarkan</span>

                    <select asp-for="JenisTiket" class="form-control" style="width:150px;">
                        <option value="Tiket MySSC">Tiket MySSC</option>
                        <option value="Tiket BAST">Tiket BAST</option>
                    </select>

                    <span>No</span>
                    <input asp-for="NoTiket" class="form-control" style="width:200px;" />
                </div>
            </div>

            <!-- TTD -->
            <div class="section-box">
                <div class="section-title">Tanda Tangan</div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <select asp-for="StaffId" class="form-control">
                            <option value="">Staff</option>
                            @foreach (var user in ViewBag.Users)
                            {
                                if (user.Role == "Staff")
                                {
                                    <option value="@user.Id">@user.Nama</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <select asp-for="ManagerId" class="form-control">
                            <option value="">Manager</option>
                            @foreach (var user in ViewBag.Users)
                            {
                                if (user.Role == "Manager")
                                {
                                    <option value="@user.Id">@user.Nama</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <input asp-for="YangMenerima" class="form-control" placeholder="Yang Menerima" />
                    </div>
                </div>
            </div>

        </form>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>
    let rowNumber = 0;

    const templates = {
    "PC": ["PC", "Monitor", "VGA", "Keyboard", "Mouse", "Hostname"],
    "Laptop": ["Notebook", "Adaptor", "Backpack", "Mouse", "Ethernet", "Chainlock", "Hostname"],
    "HT": ["HT", "Charger", "Battery", "Antenna"]
    };

    function addRow(nama = "") {
    rowNumber++;

    $("#barangTable tbody").append(`
    <tr>
    <td>${rowNumber}</td>
    <td><input name="NamaBarang[]" class="form-control" value="${nama}" /></td>
    <td><input name="SerialNumber[]" class="form-control" /></td>
    <td><input name="MerkType[]" class="form-control" /></td>
    <td><input name="Pengguna[]" class="form-control" /></td>
    <td><button type="button" class="btn btn-danger removeRow">X</button></td>
    </tr>
    `);
    }

    $("#deviceType").change(function () {
    let val = $(this).val();
    $("#barangTable tbody").empty();
    rowNumber = 0;

    if (templates[val]) {
    templates[val].forEach(x => addRow(x));
    } else {
    addRow("");
    }
    });

    $("#addRow").click(() => addRow(""));

    $(document).on("click", ".removeRow", function () {
    $(this).closest("tr").remove();

    rowNumber = 0;
    $("#barangTable tbody tr").each(function () {
    rowNumber++;
    $(this).find("td:first").text(rowNumber);
    });
    });
</script>