@model Docuflow_projectIT_KPB.Models.Surat

@{
    ViewData["Title"] = "Buat Surat";

    List<Docuflow_projectIT_KPB.Models.JenisSurat> jenisList =
        ViewBag.JenisSurat as List<Docuflow_projectIT_KPB.Models.JenisSurat>;

    List<Docuflow_projectIT_KPB.Models.User> users =
        ViewBag.Users as List<Docuflow_projectIT_KPB.Models.User>;

    var uploadedFile = ViewBag.UploadedFile as string;
}

<div class="card shadow-lg border-0">

    <div class="card-header bg-dark text-white">
        <h4 class="mb-0">Buat Surat</h4>
    </div>

    <div class="card-body">

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-info">
                @TempData["Message"]
            </div>
        }

        <!-- PREVIEW FILE -->
        @if (uploadedFile != null)
        {
            <div class="mb-4">
                <label class="fw-bold">Preview File Surat</label>

                <iframe src="@uploadedFile"
                        width="100%"
                        height="500"
                        style="border:1px solid #ddd">
                </iframe>
            </div>
        }

        <!-- NAV TAB -->
        <ul class="nav nav-tabs">
            <li class="nav-item">
                <button class="nav-link active"
                        data-bs-toggle="tab"
                        data-bs-target="#manual">
                    Manual
                </button>
            </li>

            <li class="nav-item">
                <button class="nav-link"
                        data-bs-toggle="tab"
                        data-bs-target="#upload">
                    Upload & Lengkapi
                </button>
            </li>
        </ul>

        <div class="tab-content mt-4">

            <!-- ================= MANUAL ================= -->
            <div class="tab-pane fade show active" id="manual">

                <form asp-controller="Surat"
                      asp-action="Create"
                      method="post">

                    <input type="hidden"
                           name="FilePath"
                           value="@uploadedFile" />

                    <div class="row">

                        <!-- Jenis Surat -->
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">
                                Jenis Surat
                            </label>

                            <select name="JenisSuratId"
                                    class="form-select">

                                <option value="">-- Pilih --</option>

                                @foreach (var item in jenisList)
                                {
                                    <option value="@item.Id">
                                        @item.NamaJenis
                                    </option>
                                }

                            </select>
                        </div>

                        <!-- Staff -->
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">
                                Staff
                            </label>

                            <select name="StaffId"
                                    class="form-select">

                                <option value="">-- Pilih --</option>

                                @foreach (var user in users.Where(u => u.Role == "Staff"))
                                {
                                    <option value="@user.Id">
                                        @user.Nama
                                    </option>
                                }

                            </select>
                        </div>

                        <!-- Manager -->
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">
                                Manager
                            </label>

                            <select name="ManagerId"
                                    class="form-select">

                                <option value="">-- Pilih --</option>

                                @foreach (var user in users.Where(u => u.Role == "Manager"))
                                {
                                    <option value="@user.Id">
                                        @user.Nama
                                    </option>
                                }

                            </select>
                        </div>

                        <!-- Deskripsi -->
                        <div class="col-md-12 mb-3">
                            <label class="form-label fw-bold">
                                Deskripsi
                            </label>

                            <textarea name="Deskripsi"
                                      class="form-control"
                                      rows="4"></textarea>
                        </div>

                    </div>

                    <div class="text-end">
                        <button type="submit"
                                class="btn btn-success">
                            Simpan Surat
                        </button>
                    </div>

                </form>
            </div>


            <!-- ================= UPLOAD ================= -->
            <div class="tab-pane fade" id="upload">

                <form asp-controller="Surat"
                      asp-action="UploadPreview"
                      method="post"
                      enctype="multipart/form-data">

                    <div class="mb-3">
                        <label class="form-label fw-bold">
                            Upload File Surat
                        </label>

                        <input type="file"
                               name="file"
                               class="form-control" />
                    </div>

                    <div class="text-end mt-3">
                        <button type="submit"
                                class="btn btn-primary">
                            Upload File
                        </button>
                    </div>

                </form>

            </div>

        </div>

    </div>
</div>