@model Docuflow_projectIT_KPB.Models.Surat

@{
    ViewData["Title"] = "Buat Surat";
}

<link href="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/css/select2.min.css" rel="stylesheet" />

<style>

.select2-container--default .select2-results__options{
    max-height:350px;
}

</style>

<div class="card shadow-lg border-0">

<div class="card-header bg-dark text-white">
<h4>Buat Surat Baru</h4>
</div>

<div class="card-body">

<form asp-action="Create" method="post" enctype="multipart/form-data">

<h5 class="mb-3">Informasi Surat</h5>

<div class="row">

<div class="col-md-4 mb-3">
<label>Jenis Surat</label>

<select asp-for="JenisSuratId" class="form-control select2">

<option value="">-- Pilih Jenis Surat --</option>

@foreach (var item in ViewBag.JenisSurat)
{
<option value="@item.Id">@item.NamaJenis</option>
}

</select>

</div>

<div class="col-md-4 mb-3">
<label>Tujuan</label>
<input type="text" name="Tujuan" class="form-control" />
</div>

@* <div class="col-md-4 mb-3">
<label>Format Judul Surat</label>
<input type="text" name="FormatSerahTerima" class="form-control" />
</div> *@

</div>

<hr />

<h5 class="mb-3">Data Penanggung Jawab</h5>

<div class="row">

<div class="col-md-3 mb-3">
<label>Nama Penanggung Jawab</label>
<input type="text" name="NamaPenanggungJawab" class="form-control" />
</div>

<div class="col-md-3 mb-3">
<label>Jabatan</label>
<input type="text" name="Jabatan" class="form-control" />
</div>

<div class="col-md-3 mb-3">
<label>No Pekerja</label>
<input type="text" name="NoPekerja" class="form-control" />
</div>

<div class="col-md-3 mb-3">
<label>Alamat</label>
<input type="text" name="Alamat" class="form-control" />
</div>

</div>

<hr />

<h5 class="mb-3">Daftar Barang</h5>

<table class="table table-bordered" id="barangTable">

<thead class="table-dark">
<tr>
<th width="50">No</th>
<th>Nama Barang</th>
<th>Jumlah</th>
<th>Merk Type</th>
<th>Pengguna</th>
<th width="100">Aksi</th>
</tr>
</thead>

<tbody>

<tr>

<td>1</td>

<td>
<input type="text" name="NamaBarang[]" class="form-control" />
</td>

<td>
<input type="number" name="Jumlah[]" class="form-control" />
</td>

<td>
<input type="text" name="MerkType[]" class="form-control" />
</td>

<td>
<input type="text" name="Pengguna[]" class="form-control" />
</td>

<td>
<button type="button" class="btn btn-danger removeRow">
Hapus
</button>
</td>

</tr>

</tbody>

</table>

<button type="button" class="btn btn-primary mb-4" id="addRow">
+ Tambah Barang
</button>

<hr />

<h5 class="mb-3">Catatan</h5>

<div class="row">

<div class="col-md-6 mb-3">
<label>No Tiket MySSC</label>
<input type="text" name="NoTiket" class="form-control" />
</div>

</div>

<hr />

<h5 class="mb-3">Tanda Tangan</h5>

<div class="row">

<div class="col-md-4 mb-3">

<label>Yang Menyerahkan (Staff)</label>

<select asp-for="StaffId" class="form-control select2">

<option value="">-- Pilih Staff --</option>

@foreach (var user in ViewBag.Users)
{
if (user.Role == "Staff")
{
<option value="@user.Id">@user.Nama</option>
}
}

</select>

</div>

<div class="col-md-4 mb-3">

<label>Mengetahui (Manager)</label>

<select asp-for="ManagerId" class="form-control select2">

<option value="">-- Pilih Manager --</option>

@foreach (var user in ViewBag.Users)
{
if (user.Role == "Manager")
{
<option value="@user.Id">@user.Nama</option>
}
}

</select>

</div>

<div class="col-md-4 mb-3">
<label>Yang Menerima</label>
<input type="text" name="YangMenerima" class="form-control" />
</div>

</div>

<hr />

@* <h5 class="mb-3">Upload File (Opsional)</h5>

<div class="mb-3">
<input type="file" name="file" class="form-control" />
</div> *@

<hr />

<div class="text-end">

<button type="submit" class="btn btn-success">
Simpan Surat
</button>

<a href="/Surat" class="btn btn-secondary">
Kembali
</a>

</div>

</form>

</div>

</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0/dist/js/select2.min.js"></script>

<script>

$(document).ready(function () {

$('.select2').select2({
width:'100%',
dropdownAutoWidth:true
});

});

let rowNumber = 1;

document.getElementById("addRow").addEventListener("click", function(){

rowNumber++;

let table = document.getElementById("barangTable").getElementsByTagName('tbody')[0];

let row = table.insertRow();

row.innerHTML = `
<td>${rowNumber}</td>
<td><input type="text" name="NamaBarang[]" class="form-control"/></td>
<td><input type="number" name="Jumlah[]" class="form-control"/></td>
<td><input type="text" name="MerkType[]" class="form-control"/></td>
<td><input type="text" name="Pengguna[]" class="form-control"/></td>
<td><button type="button" class="btn btn-danger removeRow">Hapus</button></td>
`;

});

document.addEventListener("click", function(e){

if(e.target.classList.contains("removeRow"))
{
e.target.closest("tr").remove();
}

});

</script>