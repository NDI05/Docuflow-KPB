@using Docuflow_projectIT_KPB.Services
@model Docuflow_projectIT_KPB.Models.Surat

@{
    // Satu formulir untuk Buat dan Ubah. Aturan per jenis surat tersebar di
    // 300 baris JS di bawah; menyalinnya jadi Edit.cshtml berarti tiap aturan
    // baru harus ditulis dua kali, dan yang terlupa hanya ketahuan dari
    // dokumen yang salah cetak.
    var ubah = Model != null && Model.Id > 0;

    ViewData["Title"] = ubah ? "Ubah berita acara" : "Buat berita acara";
    ViewData["Eyebrow"] = "Arsip";
    ViewData["Sub"] = ubah
        ? $"Nomor {Model!.NomorSurat} dan jenisnya tidak bisa diubah."
        : "Nomor surat dibuat otomatis saat disimpan.";
}

@* Tombol simpan hanya ada di kaki form. Sebelumnya ada dua — satu di bar
   atas, satu di bawah — dan dua tombol dengan tujuan sama membuat orang
   ragu apakah keduanya melakukan hal yang berbeda. *@
<div class="panel">
    @* enctype wajib: SuratController.Create menerima IFormFile. Tanpa ini
       lampiran tidak pernah sampai ke server dan FilePath selalu kosong. *@
    <form asp-action="@(ubah ? "Edit" : "Create")" method="post" id="formSurat" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        @if (ubah)
        {
            <input type="hidden" asp-for="Id" />
        }

        <div class="panel__body">

            <div class="fieldset">
                <div class="fieldset__head">
                    <span class="fieldset__no">01</span>
                    <div><h3>Jenis dan tujuan</h3></div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" asp-for="JenisSuratId">Jenis berita acara</label>
                        @* data-kode dipakai JS untuk menentukan bagian mana yang
                           ditampilkan: BAST butuh tabel barang, BA butuh poin
                           laporan, BAPB butuh tabel barang berkolom lain.

                           data-lawan membawa label kolom di sebelahnya. Pada
                           BAPB pihak lawan bisa jadi pengirim ATAU penerima
                           tergantung jenisnya, dan labelnya dihitung Bapb
                           supaya tidak berbeda dengan hasil cetaknya. *@
                        @* Dikunci saat mengubah: kode jenis sudah tercetak di dalam
                           nomor surat, jadi menggantinya membuat nomor menyebut jenis
                           yang bukan isinya. Select yang disabled tidak ikut terkirim,
                           dan SuratController.Edit memang tidak membacanya — penjagaan
                           sebenarnya ada di server, ini hanya supaya tidak menggoda. *@
                        <select asp-for="JenisSuratId" class="form-select" required disabled="@ubah">
                            <option value="">Pilih jenis</option>
                            @foreach (var j in ViewBag.JenisSurat)
                            {
                                var kodeJenis = ((string)(j.Kode ?? "")).Trim().ToUpperInvariant();

                                // Hanya BAPB yang arahnya bisa terbalik. Jenis
                                // lain tetap memakai label "Tujuan" seperti
                                // sebelumnya.
                                var labelLawan = kodeJenis == Bapb.Kode
                                    ? Bapb.LabelLawan((string)j.NamaJenis)
                                    : "Tujuan";

                                // BAPB Barang Rusak satu-satunya dokumen yang
                                // tidak mencetak baris Mengetahui. Menanyakan
                                // penanda tangan yang tidak akan muncul di
                                // kertas hanya membuat operator mengisi data
                                // yang lalu hilang tanpa penjelasan.
                                var pakaiMengetahui = !(kodeJenis == Bapb.Kode && Bapb.Rusak((string)j.NamaJenis));

                                // Pada BAPB arah masuk, pilihan staff bukan
                                // sekadar penanda tangan — ia yang tercetak di
                                // baris "Kepada" — dan isian bebas di sebelahnya
                                // berpindah arti jadi pihak yang menyerahkan.
                                var labelStaff = kodeJenis == Bapb.Kode
                                    ? Bapb.LabelStaff((string)j.NamaJenis)
                                    : "Staff";

                                var labelTerima = kodeJenis == Bapb.Kode
                                    ? Bapb.LabelYangMenerima((string)j.NamaJenis)
                                    : "Yang menerima";

                                // Jabatan pihak lawan dicetak BAPB dan BAST. Pada BAPB
                                // labelnya ikut berbalik arah; pada BAST penerimanya
                                // selalu penerima, jadi labelnya tetap. BA tidak punya
                                // kotak "Yang Menerima" sama sekali, jadi isiannya
                                // disembunyikan di sana.
                                var labelJabatanTerima =
                                    kodeJenis == Bapb.Kode ? Bapb.LabelJabatanYangMenerima((string)j.NamaJenis)
                                    : kodeJenis == Bast.Kode ? "Jabatan penerima"
                                    : null;

                                // BAPB arah IT ke vendor tidak memakai dasar
                                // pemenuhan, jadi bagiannya disembunyikan.
                                var pakaiDasar = kodeJenis != Bapb.Kode
                                    || Bapb.PakaiDasarPemenuhan((string)j.NamaJenis);

                                // BAST punya dua bentuk tabel: perangkat dan rekaman CCTV.
                                var cctv = kodeJenis == Bast.Kode && Bast.Cctv((string)j.NamaJenis);

                                // Hanya BA Survey yang mencetak baris TENTANG.
                                var pakaiTentang = kodeJenis == Ba.Kode && Ba.Survey((string)j.NamaJenis);

                                // BA Survey tidak mencetak Tujuan maupun data
                                // penanggung jawab, jadi keduanya tidak ditanyakan.
                                var pakaiTujuanPj = !pakaiTentang;

                                // BALP hanya minta nama perusahaan dan keterangan.
                                // Berkas dan tanggalnya menyusul lewat halaman unggah,
                                // dan dokumennya dibuat vendor sehingga tidak ada
                                // barang, poin, dasar pemenuhan, maupun penanda tangan.
                                var balp = kodeJenis == Balp.Kode;

                                <option value="@j.Id"
                                        data-kode="@j.Kode"
                                        data-cctv="@(cctv ? "1" : "0")"
                                        data-tentang="@(pakaiTentang ? "1" : "0")"
                                        data-tujuanpj="@(pakaiTujuanPj ? "1" : "0")"
                                        data-balp="@(balp ? "1" : "0")"
                                        data-lawan="@labelLawan"
                                        data-mengetahui="@(pakaiMengetahui ? "1" : "0")"
                                        data-dasar="@(pakaiDasar ? "1" : "0")"
                                        data-labelstaff="@labelStaff"
                                        data-labelterima="@labelTerima"
                                        data-labeljabterima="@labelJabatanTerima">@j.NamaJenis</option>
                            }
                        </select>
                        <span asp-validation-for="JenisSuratId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6" id="kolomTujuan">
                        <label class="form-label" asp-for="Tujuan" id="labelTujuan">Tujuan</label>
                        <input asp-for="Tujuan" class="form-control" placeholder="Ditujukan kepada" required />
                        <span asp-validation-for="Tujuan" class="text-danger"></span>
                    </div>

                    @* Perihal dokumen — judul satu baris yang tercetak di bawah
                       label TENTANG. Terpisah dari Catatan, yang berupa paragraf. *@
                    <div class="col-12" id="kolomTentang" hidden>
                        <label class="form-label" asp-for="Tentang">Tentang</label>
                        <input asp-for="Tentang" class="form-control"
                               placeholder="Perihal berita acara, mis. Survey Ruang Server Lantai 2" />
                    </div>

                    <div class="col-12">
                        @* Deskripsi sebelumnya tidak punya isian sama sekali,
                           padahal template BA mencetaknya dan BAPB memakainya
                           sebagai baris Catatan. *@
                        <label class="form-label" asp-for="Deskripsi" id="labelCatatan">Catatan</label>
                        <textarea asp-for="Deskripsi" class="form-control" rows="2"
                                  placeholder="Opsional. Tercetak pada baris Catatan."></textarea>
                    </div>
                </div>
            </div>

            <div class="fieldset" id="bagianPj">
                <div class="fieldset__head">
                    <span class="fieldset__no">02</span>
                    <div>
                        <h3>Penanggung jawab</h3>
                        <p class="fieldset__hint">Data ini yang tercetak pada dokumen.</p>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label" asp-for="NamaPenanggungJawab">Nama</label>
                        <input asp-for="NamaPenanggungJawab" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" asp-for="Jabatan">Jabatan</label>
                        <input asp-for="Jabatan" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" asp-for="FungsiDirektorat">Fungsi / direktorat</label>
                        <input asp-for="FungsiDirektorat" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" asp-for="NoPekerja">Nomor pekerja</label>
                        <input asp-for="NoPekerja" class="form-control" />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label" asp-for="Alamat">Alamat</label>
                        <textarea asp-for="Alamat" class="form-control" rows="2"></textarea>
                    </div>
                </div>
            </div>

            @* ================= POIN LAPORAN — jenis berkode BA ================= *@
            <div class="fieldset" id="bagianPoin" hidden>
                <div class="fieldset__head">
                    <span class="fieldset__no">03</span>
                    <div>
                        <h3>Poin laporan</h3>
                        <p class="fieldset__hint">
                            Tiap poin punya judul, keterangan, dan gambar. Tombol panah
                            menggeser tingkatnya menjadi sub-poin.
                        </p>
                    </div>
                </div>

                <div id="daftarPoin"></div>

                <button type="button" id="tambahPoin" class="btn btn-outline-secondary mt-2">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M12 5v14M5 12h14"/>
                    </svg>
                    Tambah poin
                </button>
            </div>

            @* ============ DAFTAR BARANG — jenis berkode BAST dan BAPB ============

               Satu tabel, dua susunan kolom. BAST memakai nama barang dan
               pengguna; BAPB memakai jumlah, satuan, dan keterangan. Kolom
               yang tidak dipakai disembunyikan lewat kelas pada tabelnya,
               bukan dibuatkan tabel kedua — pembangun baris, penomoran ulang,
               dan tombol hapusnya sama persis.                              *@
            <div class="fieldset" id="bagianBarang">
                <div class="fieldset__head">
                    <span class="fieldset__no">03</span>
                    <div>
                        <h3>Daftar barang</h3>
                        <p class="fieldset__hint" id="hintBarang">Satu baris per barang. Tambah baris seperlunya.</p>
                    </div>
                </div>

                <div class="ledger--wrap">
                    <table class="ledger barang--bast" id="barangTable">
                        <thead>
                            @* Urutan kolom di DOM dipilih supaya SATU urutan menghasilkan
                               urutan yang benar untuk ketiga varian setelah kolom yang tidak
                               dipakai disembunyikan:
                                 BAST : No, Nama, Serial, Merk, Pengguna
                                 CCTV : No, Nama, Tanggal, Jam, Rekaman, Area
                                 BAPB : No, Jumlah, Satuan, Serial, Merk, Keterangan
                               Kelas menamai ISI kolom, bukan variannya, karena beberapa kolom
                               dipakai lebih dari satu varian. Kelas di <th> WAJIB sama dengan
                               di <td>; kalau berbeda, judulnya tetap tampil sementara isinya
                               tersembunyi.                                                  *@
                            <tr>
                                <th style="width:40px;">#</th>
                                <th class="k-nama">Nama barang</th>
                                <th class="k-jumlah" style="width:90px;">Jumlah</th>
                                <th class="k-jumlah" style="width:90px;">Satuan</th>
                                <th class="k-waktu" style="width:150px;">Tanggal</th>
                                <th class="k-waktu" style="width:130px;">Jam</th>
                                <th class="k-alat">Serial number</th>
                                <th class="k-alat">Merk / tipe</th>
                                <th class="k-rekaman">Rekaman</th>
                                <th class="k-rekaman">Area</th>
                                <th class="k-pengguna">Pengguna</th>
                                <th class="k-ket">Keterangan</th>
                                <th style="width:40px;"><span class="visually-hidden">Hapus baris</span></th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>

                <button type="button" id="addRow" class="btn btn-outline-secondary mt-3">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M12 5v14M5 12h14"/>
                    </svg>
                    Tambah baris
                </button>
            </div>

            <div class="fieldset" id="bagianDasar">
                <div class="fieldset__head">
                    <span class="fieldset__no">04</span>
                    <div><h3>Dasar pemenuhan</h3></div>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        @* Nilainya ikut tercetak di baris Catatan pada BAST,
                           jadi teks opsi ini yang muncul apa adanya di dokumen. *@
                        <label class="form-label" asp-for="JenisTiket">Dasar</label>
                        <select asp-for="JenisTiket" class="form-select">
                            <option value="Tiket MySSC">Tiket MySSC</option>
                            <option value="Nomor Memo">Nomor Memo</option>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" asp-for="NoTiket">Nomor</label>
                        <input asp-for="NoTiket" class="form-control" />
                    </div>
                </div>
            </div>

            <div class="fieldset" id="bagianTtd">
                <div class="fieldset__head">
                    <span class="fieldset__no">05</span>
                    <div><h3>Penanda tangan</h3></div>
                </div>

                <div class="row g-3">
                    @* Disaring lewat Jabatan, bukan Role. Role hanya menentukan hak
                       akses, sehingga seorang Admin tetap bisa terdaftar sebagai
                       penanda tangan. Peran manajer/staf dihitung dari jabatannya
                       lewat JabatanUser, tidak disimpan sebagai kolom tersendiri. *@
                    <div class="col-md-4">
                        <label class="form-label" asp-for="StaffId" id="labelStaff">Staff</label>
                        <select asp-for="StaffId" class="form-select">
                            <option value="">Pilih staff</option>
                            @foreach (var user in ViewBag.Users)
                            {
                                if (JabatanUser.Staf((string)user.Jabatan))
                                {
                                    <option value="@user.Id">@user.Nama — @user.Jabatan</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-4" id="kolomMengetahui">
                        <label class="form-label" asp-for="ManagerId">Mengetahui</label>
                        <select asp-for="ManagerId" class="form-select">
                            <option value="">Pilih manager</option>
                            @foreach (var user in ViewBag.Users)
                            {
                                if (JabatanUser.Manajer((string)user.Jabatan))
                                {
                                    <option value="@user.Id">@user.Nama — @user.Jabatan</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="col-md-4">
                        <label class="form-label" asp-for="YangMenerima" id="labelYangMenerima">Yang menerima</label>
                        <input asp-for="YangMenerima" class="form-control" />
                    </div>

                    @* Jabatan pihak lawan. Boleh kosong — vendor sering hanya
                       diwakili nama, dan barisnya memang tidak dicetak kalau
                       kosong. Tidak diambil dari tabel Users karena orang ini
                       bukan pengguna aplikasi. *@
                    <div class="col-md-4" id="kolomJabatanTerima" hidden>
                        <label class="form-label" asp-for="JabatanYangMenerima" id="labelJabatanTerima">Jabatan penerima</label>
                        <input asp-for="JabatanYangMenerima" class="form-control"
                               placeholder="Opsional, mis. Officer Procurement" />
                    </div>
                </div>
            </div>

            <div class="fieldset" id="bagianLampiran">
                <div class="fieldset__head">
                    <span class="fieldset__no">06</span>
                    <div>
                        <h3>Lampiran</h3>
                        <p class="fieldset__hint">Opsional. Berkas asli tersimpan dan bisa diunduh lagi dari halaman detail.</p>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="file">Berkas</label>
                        <input type="file" id="file" name="file" class="form-control" />
                        @if (ubah && !string.IsNullOrEmpty(Model!.FilePath))
                        {
                            <div class="fieldset__hint" style="margin-top:6px">
                                Terpasang:
                                <a href="@Url.Content("~" + Model.FilePath)" target="_blank" rel="noopener">
                                    @System.IO.Path.GetFileName(Model.FilePath)
                                </a>.
                                Mengunggah berkas baru akan menggantikannya.
                            </div>
                        }
                    </div>
                </div>
            </div>

        </div>

        <div class="panel__head" style="border-top:1px solid var(--rule); border-bottom:0;">
            <a class="btn btn-outline-secondary"
               asp-action="@(ubah ? "Details" : "Index")"
               asp-route-id="@(ubah ? (int?)Model!.Id : null)">Batal</a>
            <button type="submit" class="btn btn-primary">
                @(ubah ? "Simpan perubahan" : "Simpan berita acara")
            </button>
        </div>

    </form>
</div>

@section Scripts {
@if (ubah)
{
    @* Ditulis sebagai JSON, bukan dirakit jadi HTML di server: isinya teks
       bebas dari operator, dan @@Html.Raw atas string yang dirangkai tangan
       adalah cara paling mudah menyuntikkan skrip ke halaman sendiri.
       @@Json.Serialize sudah meloloskan < / & dengan benar. *@
    <script>
        window.__seedBarang = @Json.Serialize((Model!.BarangList ?? new List<Docuflow_projectIT_KPB.Models.BarangSurat>())
            .Select(b => new {
                NamaBarang = b.NamaBarang,
                Jumlah = b.Jumlah,
                Satuan = b.Satuan,
                TanggalBarang = b.Tanggal,
                JamBarang = b.Jam,
                SerialNumber = b.SerialNumber,
                MerkType = b.MerkType,
                Rekaman = b.Rekaman,
                Area = b.Area,
                Pengguna = b.Pengguna,
                Keterangan = b.Keterangan
            }));

        window.__seedPoin = @Json.Serialize((Model.PoinList ?? new List<Docuflow_projectIT_KPB.Models.PoinSurat>())
            .OrderBy(x => x.Urutan)
            .Select(x => new {
                level = x.Level,
                judul = x.Judul,
                keterangan = x.Keterangan,
                // Dua nilai, dan keduanya perlu. src untuk ditampilkan —
                // di bawah /docflow path berawalan "/" menunjuk ke luar
                // aplikasi dan gambarnya rusak. path untuk dikirim balik apa
                // adanya; menyimpan bentuk ber-Url.Content akan menulis
                // "/docflow/uploads/..." ke database dan merusaknya pada
                // simpanan berikutnya.
                gambar = x.Gambar.OrderBy(g => g.Urutan)
                                 .Select(g => new { src = Url.Content("~" + g.FilePath), path = g.FilePath })
            }));
    </script>
}
<script>
    // JS biasa, tanpa jQuery. Halaman ini sebelumnya menarik jQuery dari
    // code.jquery.com — satu-satunya dependensi internet saat runtime, dan
    // tabel ini mati kalau VM tidak bisa keluar jaringan.
    (function () {
        var tbody  = document.querySelector("#barangTable tbody");
        var tambah = document.getElementById("addRow");

        // Nomor dihitung ulang dari posisi baris, bukan dari penghitung yang
        // hanya naik — versi lama membuat kolom "No" melompat setelah hapus.
        function nomoriUlang() {
            Array.prototype.forEach.call(tbody.rows, function (tr, i) {
                tr.cells[0].textContent = i + 1;
            });
        }

        // Kelas kolom harus sama dengan yang ada di <thead>, kalau tidak
        // kolom yang disembunyikan pada judul tetap muncul pada isinya.
        function sel(nama, kelas, tipe) {
            var td = document.createElement("td");
            if (kelas) td.className = kelas;

            var input = document.createElement("input");
            input.name = nama;
            input.className = "form-control";
            if (tipe) input.type = tipe;
            if (tipe === "number") input.min = "1";

            td.appendChild(input);
            return td;
        }

        // Setiap baris selalu mengirim SELURUH kolom, termasuk yang sedang
        // disembunyikan. Controller memasangkan ketujuh array berdasarkan
        // indeks, jadi array yang panjangnya berbeda akan menggeser data satu
        // baris ke baris lain.
        function tambahBaris(nilai) {
            var tr = document.createElement("tr");

            var no = document.createElement("td");
            no.className = "num";
            tr.appendChild(no);

            tr.appendChild(sel("NamaBarang[]", "k-nama"));

            var tdJumlah = sel("Jumlah[]", "k-jumlah", "number");
            tdJumlah.firstChild.value = "1";
            tr.appendChild(tdJumlah);

            var tdSatuan = sel("Satuan[]", "k-jumlah");
            tdSatuan.firstChild.placeholder = "pcs";
            tr.appendChild(tdSatuan);

            // Nama field TanggalBarang/JamBarang, bukan Tanggal/Jam: parameter
            // aksi Create adalah Surat, yang punya properti Tanggal sendiri.
            var tdTanggal = sel("TanggalBarang[]", "k-waktu");
            tdTanggal.firstChild.placeholder = "1 - 15 Agustus 2026";
            tr.appendChild(tdTanggal);

            var tdJam = sel("JamBarang[]", "k-waktu");
            tdJam.firstChild.placeholder = "08:00 - 17:00 WITA";
            tr.appendChild(tdJam);

            tr.appendChild(sel("SerialNumber[]", "k-alat"));
            tr.appendChild(sel("MerkType[]", "k-alat"));
            tr.appendChild(sel("Rekaman[]", "k-rekaman"));
            tr.appendChild(sel("Area[]", "k-rekaman"));
            tr.appendChild(sel("Pengguna[]", "k-pengguna"));
            tr.appendChild(sel("Keterangan[]", "k-ket"));

            var tdAksi = document.createElement("td");
            var hapus = document.createElement("button");
            hapus.type = "button";
            hapus.className = "btn btn-outline-secondary btn-sm text-danger";
            hapus.textContent = "×";
            hapus.setAttribute("aria-label", "Hapus baris");
            hapus.addEventListener("click", function () {
                tr.remove();
                nomoriUlang();
            });
            tdAksi.appendChild(hapus);
            tr.appendChild(tdAksi);

            // Diisi lewat name-nya, bukan lewat urutan sel: urutan kolom di
            // DOM sengaja tidak sama dengan urutan tampilnya pada tiap varian,
            // jadi mencocokkan lewat posisi akan menggeser data.
            if (nilai) {
                // Dicocokkan tanpa peduli besar-kecil huruf: Json.Serialize
                // memakai camelCase, sementara name input-nya PascalCase.
                // Menyamakan salah satunya membuat pengisian ini diam-diam
                // gagal begitu kebijakan penamaan JSON diubah.
                var cari = {};
                Object.keys(nilai).forEach(function (k) { cari[k.toLowerCase()] = nilai[k]; });

                Array.prototype.forEach.call(tr.querySelectorAll("input[name]"), function (inp) {
                    var v = cari[inp.name.replace("[]", "").toLowerCase()];
                    if (v !== undefined && v !== null) inp.value = v;
                });
            }

            tbody.appendChild(tr);
            nomoriUlang();
        }

        // addEventListener meneruskan objek Event sebagai argumen pertama, dan
        // itu akan terbaca sebagai "nilai awal". Dibungkus supaya tidak.
        tambah.addEventListener("click", function () { tambahBaris(); });

        var awalBarang = window.__seedBarang || [];
        if (awalBarang.length) awalBarang.forEach(tambahBaris);
        else tambahBaris();
    })();

    // ==================================================================
    // Poin laporan (jenis surat berkode BA)
    // ==================================================================
    (function () {
        var daftar  = document.getElementById("daftarPoin");
        var tambah  = document.getElementById("tambahPoin");
        var jenis   = document.getElementById("JenisSuratId");
        var secPoin = document.getElementById("bagianPoin");
        var secBrg  = document.getElementById("bagianBarang");

        var MAKS_LEVEL = 2;
        var urutKunci = 0;

        // Nomor 1 / 1.1 / 1.1.1 dihitung ulang dari seluruh daftar setiap kali
        // ada perubahan — tidak pernah disimpan, jadi tidak bisa basi.
        function nomoriUlang() {
            var hitung = [0, 0, 0];

            Array.prototype.forEach.call(daftar.children, function (row) {
                var lv = parseInt(row.dataset.level, 10) || 0;

                hitung[lv]++;
                for (var d = lv + 1; d < hitung.length; d++) hitung[d] = 0;

                row.querySelector(".poin__no").textContent = hitung.slice(0, lv + 1).join(".");
                row.querySelector("input[name='PoinLevel[]']").value = lv;
                row.style.marginLeft = (lv * 32) + "px";
            });
        }

        // Sebuah poin paling dalam hanya boleh satu tingkat di bawah poin
        // sebelumnya. Tanpa aturan ini bisa muncul sub-poin tanpa induk.
        function levelMaksimum(row) {
            var sebelum = row.previousElementSibling;
            if (!sebelum) return 0;
            return Math.min(MAKS_LEVEL, (parseInt(sebelum.dataset.level, 10) || 0) + 1);
        }

        function geser(row, arah) {
            var lv = parseInt(row.dataset.level, 10) || 0;
            var baru = Math.max(0, Math.min(levelMaksimum(row), lv + arah));
            row.dataset.level = baru;
            nomoriUlang();
        }

        function tambahPoin(data) {
            var kunci = "p" + (++urutKunci);

            var row = document.createElement("div");
            row.className = "poin";
            row.dataset.level = "0";

            var head = document.createElement("div");
            head.className = "poin__head";

            var no = document.createElement("span");
            no.className = "poin__no";
            head.appendChild(no);

            var judul = document.createElement("input");
            judul.name = "PoinJudul[]";
            judul.className = "form-control";
            judul.placeholder = "Judul poin";
            head.appendChild(judul);

            var aksi = document.createElement("div");
            aksi.className = "poin__aksi";

            [["←", "Naikkan tingkat", -1], ["→", "Turunkan tingkat", 1]].forEach(function (a) {
                var b = document.createElement("button");
                b.type = "button";
                b.className = "btn btn-outline-secondary btn-sm";
                b.textContent = a[0];
                b.setAttribute("aria-label", a[1]);
                b.addEventListener("click", function () { geser(row, a[2]); });
                aksi.appendChild(b);
            });

            var hapus = document.createElement("button");
            hapus.type = "button";
            hapus.className = "btn btn-outline-secondary btn-sm text-danger";
            hapus.textContent = "×";
            hapus.setAttribute("aria-label", "Hapus poin");
            hapus.addEventListener("click", function () { row.remove(); nomoriUlang(); });
            aksi.appendChild(hapus);

            head.appendChild(aksi);
            row.appendChild(head);

            var kunciInput = document.createElement("input");
            kunciInput.type = "hidden";
            kunciInput.name = "PoinKey[]";
            kunciInput.value = kunci;
            row.appendChild(kunciInput);

            var levelInput = document.createElement("input");
            levelInput.type = "hidden";
            levelInput.name = "PoinLevel[]";
            levelInput.value = "0";
            row.appendChild(levelInput);

            var ket = document.createElement("textarea");
            ket.name = "PoinKeterangan[]";
            ket.className = "form-control";
            ket.rows = 2;
            ket.placeholder = "Keterangan poin";
            row.appendChild(ket);

            var bungkus = document.createElement("div");
            bungkus.className = "poin__berkas";
            var gambar = document.createElement("input");
            gambar.type = "file";
            // Dinamai per kunci, bukan per indeks: menghapus satu baris tidak
            // boleh memindahkan gambar milik baris lain.
            gambar.name = "Gambar_" + kunci;
            gambar.className = "form-control";
            gambar.multiple = true;
            gambar.accept = "image/*";
            bungkus.appendChild(gambar);
            row.appendChild(bungkus);

            if (data) {
                judul.value = data.judul || "";
                ket.value = data.keterangan || "";
                row.dataset.level = String(data.level || 0);

                // Gambar yang sudah tersimpan dikirim balik apa adanya lewat
                // input tersembunyi. Yang tombol silangnya ditekan tidak ikut
                // terkirim, dan itulah tanda bagi server untuk membuangnya.
                (data.gambar || []).forEach(function (g) {
                    var item = document.createElement("span");
                    item.className = "poin__lama";

                    var img = document.createElement("img");
                    img.src = g.src;
                    img.alt = "";
                    item.appendChild(img);

                    var hid = document.createElement("input");
                    hid.type = "hidden";
                    hid.name = "GambarLama_" + kunci + "[]";
                    hid.value = g.path;
                    item.appendChild(hid);

                    var buang = document.createElement("button");
                    buang.type = "button";
                    buang.textContent = "×";
                    buang.setAttribute("aria-label", "Hapus gambar ini");
                    buang.addEventListener("click", function () { item.remove(); });
                    item.appendChild(buang);

                    bungkus.appendChild(item);
                });
            }

            daftar.appendChild(row);
            nomoriUlang();
        }

        var tabelBrg  = document.getElementById("barangTable");
        var hintBrg   = document.getElementById("hintBarang");
        var labelTuju = document.getElementById("labelTujuan");
        var inputTuju = document.getElementById("Tujuan");
        var kolomTahu = document.getElementById("kolomMengetahui");
        var kolomJabTerima = document.getElementById("kolomJabatanTerima");
        var inputJabTerima = document.getElementById("JabatanYangMenerima");
        var labelJabTerima = document.getElementById("labelJabatanTerima");
        var selectTahu = document.getElementById("ManagerId");
        var labelStaff = document.getElementById("labelStaff");
        var labelTerima = document.getElementById("labelYangMenerima");
        var secDasar = document.getElementById("bagianDasar");
        var secTtd = document.getElementById("bagianTtd");
        var secLampiran = document.getElementById("bagianLampiran");
        var labelCatatan = document.getElementById("labelCatatan");
        var kolomTentang = document.getElementById("kolomTentang");
        var inputTentang = document.getElementById("Tentang");
        var kolomTujuan = document.getElementById("kolomTujuan");
        var secPj = document.getElementById("bagianPj");
        var selJenisTiket = document.getElementById("JenisTiket");
        var inputNoTiket = document.getElementById("NoTiket");

        var HINT_BAST = "Satu baris per barang. Tambah baris seperlunya.";
        var HINT_BAPB = "Jumlah dalam huruf ditulis otomatis saat dicetak. Satuan kosong dicetak \u201cpcs\u201d.";
        var HINT_CCTV = "Satu baris per rekaman. Tanggal dan jam boleh berupa rentang.";

        // Nomor bagian dihitung ulang dari bagian yang TERLIHAT. Beberapa
        // bagian muncul-hilang menurut jenis, dan penomoran statis menyisakan
        // lompatan (01, 03, 04, 06) yang terbaca seperti form yang rusak.
        function nomoriBagian() {
            var n = 0;
            Array.prototype.forEach.call(
                document.querySelectorAll("#formSurat .fieldset"),
                function (fs) {
                    if (fs.hidden) return;
                    n++;
                    var label = fs.querySelector(".fieldset__no");
                    if (label) label.textContent = ("0" + n).slice(-2);
                });
        }

        function pilihBagian() {
            var opsi = jenis.options[jenis.selectedIndex];
            var kode = opsi ? (opsi.getAttribute("data-kode") || "").trim().toUpperCase() : "";

            var laporan = kode === "BA";
            var pengembalian = kode === "BAPB";
            var cctv = !!opsi && opsi.getAttribute("data-cctv") === "1";

            // BALP tidak dicetak Docuflow, jadi hampir seluruh formulir tidak
            // berlaku: yang tersisa hanya nama perusahaan dan keterangan.
            var balp = !!opsi && opsi.getAttribute("data-balp") === "1";

            secPoin.hidden = !laporan || balp;
            secBrg.hidden = laporan || balp;
            secTtd.hidden = balp;
            secLampiran.hidden = balp;

            // Satu tabel, tiga susunan kolom. Varian dipilih di sini, bukan
            // dengan membuat tabel kedua dan ketiga: pembangun baris,
            // penomoran ulang, dan tombol hapusnya sama persis.
            tabelBrg.classList.toggle("barang--bapb", pengembalian);
            tabelBrg.classList.toggle("barang--cctv", cctv);
            tabelBrg.classList.toggle("barang--bast", !pengembalian && !cctv);

            hintBrg.textContent = pengembalian ? HINT_BAPB : (cctv ? HINT_CCTV : HINT_BAST);

            // Dikosongkan saat disembunyikan: perihal yang terlanjur diketik
            // pada jenis yang tidak mencetaknya akan tersimpan tanpa pernah
            // muncul di kertas.
            labelCatatan.textContent = balp ? "Keterangan BALP" : "Catatan";

            var pakaiTentang = !!opsi && opsi.getAttribute("data-tentang") === "1";
            kolomTentang.hidden = !pakaiTentang;
            if (!pakaiTentang) inputTentang.value = "";

            // Tujuan dan data penanggung jawab.
            //
            // required WAJIB dilepas saat disembunyikan. Peramban menolak
            // mengirim form yang punya kendali required tak terlihat, dan
            // pesannya ("not focusable") hanya muncul di konsol — tombol
            // Simpan tampak tidak melakukan apa-apa.
            var pakaiTujuanPj = !opsi || opsi.getAttribute("data-tujuanpj") !== "0";

            // BALP tetap memakai kolom Tujuan, tapi isinya nama perusahaan
            // vendor; bagian penanggung jawabnya yang tidak berlaku.
            kolomTujuan.hidden = !pakaiTujuanPj && !balp;
            inputTuju.required = pakaiTujuanPj || balp;
            if (!pakaiTujuanPj && !balp) inputTuju.value = "";

            secPj.hidden = !pakaiTujuanPj || balp;
            if (!pakaiTujuanPj) {
                Array.prototype.forEach.call(
                    secPj.querySelectorAll("input, textarea"),
                    function (el) { el.value = ""; });
            }

            // Label kolom lawan datang dari server: arah BAPB ditentukan di
            // Bapb.LabelLawan supaya layar dan hasil cetak tidak berbeda.
            var lawan = balp ? "Nama perusahaan"
                             : ((opsi && opsi.getAttribute("data-lawan")) || "Tujuan");
            labelTuju.textContent = lawan;

            // Placeholder bawaan berbunyi "Ditujukan kepada" — menyesatkan
            // pada BAPB yang arahnya masuk. Labelnya sudah menjelaskan, jadi
            // di situ placeholder dikosongkan saja.
            inputTuju.placeholder = lawan === "Tujuan" ? "Ditujukan kepada" : "";

            // Dikosongkan, bukan sekadar disembunyikan: kalau operator sempat
            // memilih manager lalu berpindah ke jenis yang tidak mencetaknya,
            // nilainya tetap ikut terkirim dan halaman detail akan menampilkan
            // penanda tangan yang tidak ada di dokumennya.
            var pakaiTahu = !opsi || opsi.getAttribute("data-mengetahui") !== "0";
            kolomTahu.hidden = !pakaiTahu;
            if (!pakaiTahu) selectTahu.value = "";

            labelStaff.textContent = (opsi && opsi.getAttribute("data-labelstaff")) || "Staff";
            labelTerima.textContent = (opsi && opsi.getAttribute("data-labelterima")) || "Yang menerima";

            var labJab = opsi && opsi.getAttribute("data-labeljabterima");
            kolomJabTerima.hidden = !labJab;
            if (labJab) { labelJabTerima.textContent = labJab; }
            else { inputJabTerima.value = ""; }

            // Dikosongkan saat disembunyikan, bukan sekadar disembunyikan.
            // <select> jenis tiket tidak punya opsi kosong, jadi tanpa ini
            // "Tiket MySSC" tetap ikut terkirim dan tersimpan diam-diam pada
            // surat yang tidak pernah menampilkannya.
            var pakaiDasar = (!opsi || opsi.getAttribute("data-dasar") !== "0") && !balp;
            secDasar.hidden = !pakaiDasar;
            if (!pakaiDasar) {
                selJenisTiket.selectedIndex = -1;
                inputNoTiket.value = "";
            } else if (selJenisTiket.selectedIndex === -1) {
                selJenisTiket.selectedIndex = 0;
            }

            if (laporan && daftar.children.length === 0) tambahPoin();

            // Paling akhir: seluruh keputusan hidden di atas harus sudah
            // selesai sebelum bagian yang terlihat dihitung ulang.
            nomoriBagian();
        }

        tambah.addEventListener("click", function () { tambahPoin(); });
        jenis.addEventListener("change", pilihBagian);

        (window.__seedPoin || []).forEach(tambahPoin);

        pilihBagian();
    })();
</script>
}
