@model Docuflow_projectIT_KPB.Models.Surat
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Preview Surat</title>

    <style>
            body {
                margin: 0;
                padding: 20px;
                background: #f2f2f2;
                font-family: Arial, Helvetica, sans-serif;
            }

            .paper {
                width: 900px;
                margin: 20px auto;
                background: #fff;
                padding: 35px 45px 45px 45px;
                box-shadow: 0 0 12px rgba(0,0,0,0.15);
                font-size: 14px;
                color: #000;
            }

            /* ================= HEADER ================= */
            .header {
                position: relative;
                min-height: 120px;
                margin-bottom: 30px;
            }

            /* logo dibesarin dikit */
            .logo {
                position: absolute;
                top: 0;
                left: 0;
                width: 150px;
            }

            /* kop surat digeser agak ke kanan */
            .header-center {
                margin-left: 115px;
                margin-right: 280px;
                text-align: center;
                padding-top: 2px;
            }

            .company {
                font-size: 18px;
                font-weight: bold;
                line-height: 1.2;
            }

            .company-sub {
                font-size: 18px;
                font-weight: bold;
                margin-top: 2px;
            }

            .alamat {
                margin-top: 8px;
                font-size: 13px;
                line-height: 1.4;
            }

            /* box kanan tanpa garis vertikal berlebih */
            .box-info {
                position: absolute;
                top: 0;
                right: 0;
                width: 255px;
                border: 1px solid #000;
                border-collapse: collapse;
                font-size: 13px;
            }

                .box-info td {
                    border-bottom: 1px solid #000;
                    padding: 4px 8px;
                    vertical-align: top;
                }

                .box-info tr:last-child td {
                    border-bottom: none;
                }

                .box-info .label {
                    width: 65px;
                    white-space: nowrap;
                    border-right: none;
                    padding-right: 2px;
                }

                .box-info .separator {
                    width: 10px;
                    text-align: center;
                    border-left: none;
                    border-right: none;
                    padding-left: 0;
                    padding-right: 0;
                }

                .box-info .value {
                    border-left: none;
                    font-weight: bold;
                    padding-left: 2px;
                }

            /* ================= TITLE ================= */
            .title {
                text-align: center;
                font-size: 16px;
                font-weight: bold;
                text-decoration: underline;
                margin: 10px 0 22px 0;
            }

            /* ================= INFO TABLE ================= */
            .info-table {
                width: 100%;
                border-collapse: collapse;
                margin-bottom: 18px;
            }

                .info-table td {
                    border: none;
                    padding: 3px 0;
                    vertical-align: top;
                    font-size: 14px;
                }

                .info-table .label {
                    width: 210px;
                }

                .info-table .colon {
                    width: 15px;
                    text-align: center;
                }

                .info-table .value {
                    width: 260px;
                }

            /* ================= TABEL BARANG ================= */
            .barang-table {
                width: 100%;
                border-collapse: collapse;
                margin-top: 10px;
                font-size: 13px;
            }

                .barang-table th,
                .barang-table td {
                    border: 1px solid #000;
                    padding: 7px 8px;
                }

                .barang-table th {
                    text-align: center;
                    background: #f3f3f3;
                    font-weight: bold;
                }

                .barang-table td {
                    vertical-align: top;
                }

            .text-left {
                text-align: left;
            }

            .text-center {
                text-align: center;
            }

            /* ================= PARAGRAPH ================= */
            .paragraph {
                margin-top: 12px;
                text-align: justify;
                line-height: 1.5;
                font-size: 13px;
            }

            /* ================= SIGNATURE ================= */
            .signature {
                width: 100%;
                border-collapse: collapse;
                margin-top: 45px;
            }

                .signature td {
                    border: none;
                    text-align: center;
                    vertical-align: top;
                    width: 25%;
                    padding: 0 10px;
                    font-size: 13px;
                }

            .sign-space {
                height: 75px;
            }

            .signature-name {
                font-weight: bold;
                text-decoration: underline;
            }
    </style>
</head>
<body>

    <div class="paper">

        <div class="header">

            <img src="/images/Logo_pertamina.png" class="logo" />

            <div class="header-center">
                <div class="company">PT KILANG PERTAMINA</div>
                <div class="company-sub">BALIKPAPAN</div>

                <div class="alamat">
                    Kantor NSO PT Kilang Pertamina Balikpapan<br />
                    JL. Yos Sudarso No.1 Balikpapan
                </div>
            </div>

            <table class="box-info">
                <tr>
                    <td class="label">Nomor</td>
                    <td class="separator">:</td>
                    <td class="value">@Model.NomorSurat</td>
                </tr>
                <tr>
                    <td class="label">Tanggal</td>
                    <td class="separator">:</td>
                    <td class="value">@Model.Tanggal.ToString("dd MMMM yyyy")</td>
                </tr>
                <tr>
                    <td class="label">Dari</td>
                    <td class="separator">:</td>
                    <td class="value">Ruang IT KPB</td>
                </tr>
                <tr>
                    <td class="label">Tujuan</td>
                    <td class="separator">:</td>
                    <td class="value">@Model.Tujuan</td>
                </tr>
            </table>

        </div>

        <div class="title">
            @(Model.JenisSurat?.NamaJenis?.ToUpper())
        </div>

        <table class="info-table">
            <tr>
                <td class="label"><b>Nama Penanggung Jawab</b></td>
                <td class="colon">:</td>
                <td class="value">@Model.NamaPenanggungJawab</td>

                <td class="label" style="width:120px;"><b>No. Pekerja</b></td>
                <td class="colon">:</td>
                <td>@Model.NoPekerja</td>
            </tr>

            <tr>
                <td class="label"><b>Jabatan</b></td>
                <td class="colon">:</td>
                <td class="value">@Model.Jabatan</td>
            </tr>

            <tr>
                <td class="label"><b>Alamat</b></td>
                <td class="colon">:</td>
                <td class="value">@Model.Alamat</td>
            </tr>
        </table>

        <table class="barang-table">
            <thead>
                <tr>
                    <th width="50">No</th>
                    <th>Nama Barang</th>
                    <th width="80">Jumlah</th>
                    <th width="160">Merk Type</th>
                    <th width="160">Pengguna</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.BarangList != null && Model.BarangList.Any())
                {
                    int no = 1;

                    foreach (var barang in Model.BarangList)
                    {
                        <tr>
                            <td class="text-center">@no</td>
                            <td class="text-left">@barang.NamaBarang</td>
                            <td class="text-center">@barang.Jumlah</td>
                            <td class="text-center">@barang.MerkType</td>
                            <td class="text-center">@barang.Pengguna</td>
                        </tr>

                        no++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center">Tidak ada data barang</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="paragraph">
            <b>Catatan : Pemenuhan Permintaan Berdasarkan</b>
            @Model.JenisTiket No @Model.NoTiket
        </div>

        <div class="paragraph">
            I. Telah dilakukan uji-coba terhadap barang yang diserahkan sesuai dengan data diatas,
            yang dilaksanakan oleh petugas dari staff IT KPB dan pihak penerima sebagai pemakai /
            penanggung jawab, semua sepakat bahwa barang tersebut telah sesuai seperti tercantum
            di atas dan bekerja dengan baik serta laik pakai.
        </div>

        <div class="paragraph">
            II. Pihak penerima bertanggung jawab sepenuhnya atas barang yang digunakan dan telah
            membaca serta setuju dengan ketentuan tambahan yang tercantum pada halaman belakang
            dari lembar bukti penerimaan barang ini (wajib dibaca).
        </div>

        <div class="paragraph">
            III. Apabila terjadi pencurian / kehilangan barang yang diserahkan kepada pemakai /
            penanggung jawab, maka pemakai / penanggung jawab harus melaporkan kepada Kepolisian
            dan Sekuriti Pertamina dimana terjadi kehilangan barang tersebut.
        </div>

        <div class="paragraph">
            IV. Perangkat IT yang tidak harus / wajib dikembalikan ke Fungsi IT KPB Direktorat
            Keuangan apabila pekerja mutasi / keluar.
        </div>

        <div class="paragraph">
            V. Kami sebagai Penerima/Penanggung Jawab telah membaca, memahami dan menerima
            semua ketentuan Perusahaan tersebut.
        </div>

        <table class="signature">
            <tr>
                <td>Yang Menyerahkan</td>
                <td>Mengetahui<br />Ast Manager IT | PT. KPB</td>
                <td>Yang Bertanggung Jawab</td>
                <td>
                    Balikpapan, @Model.Tanggal.ToString("dd.MM.yyyy")<br />
                    Yang Menerima
                </td>
            </tr>

            <tr>
                <td class="sign-space"></td>
                <td class="sign-space"></td>
                <td class="sign-space"></td>
                <td class="sign-space"></td>
            </tr>

            <tr>
                <td class="signature-name">@Model.Staff?.Nama</td>
                <td class="signature-name">@Model.Manager?.Nama</td>
                <td class="signature-name">@Model.NamaPenanggungJawab</td>
                <td class="signature-name">@Model.YangMenerima</td>
            </tr>
        </table>

    </div>

</body>
</html>