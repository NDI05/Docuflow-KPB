@model ErrorViewModel
@{
    ViewData["Title"] = "Terjadi Kesalahan";
}

<div class="kpb-head">
    <div>
        <h1>Halaman gagal dimuat</h1>
        <p>Permintaan terakhir tidak dapat diselesaikan.</p>
    </div>

    <div class="kpb-head-actions">
        <a asp-controller="Home" asp-action="Index" class="btn btn-on-ink btn-sm">Kembali ke Beranda</a>
    </div>
</div>

<div class="kpb-panel-body">

    <p>
        Coba muat ulang halaman. Jika kesalahan berulang, hubungi Information Technology
        KPB dan sertakan kode di bawah ini.
    </p>

    @if (Model.ShowRequestId)
    {
        <div class="kpb-section">
            <div class="kpb-mark" aria-hidden="true"><span></span><span></span><span></span></div>
            <h2>Kode Permintaan</h2>
            <div class="kpb-rule"></div>
        </div>

        <code>@Model.RequestId</code>
    }

</div>
