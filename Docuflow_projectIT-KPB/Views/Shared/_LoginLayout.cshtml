<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Docuflow</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
            body {
                background: linear-gradient(135deg, #1d2bff, #0d1a8a);
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                font-family: 'Segoe UI', sans-serif;
            }

            .login-card {
                width: 380px;
                background: white;
                border-radius: 18px;
                padding: 30px;
                box-shadow: 0px 10px 30px rgba(0,0,0,0.25);
            }

            .login-title {
                font-weight: 800;
                font-size: 22px;
                text-align: center;
                margin-bottom: 20px;
                color: #111827;
            }

            .btn-login {
                width: 100%;
                border-radius: 12px;
                font-weight: 700;
                padding: 10px;
            }
    </style>
</head>
<body>

    <div class="login-card">
        @RenderBody()
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>