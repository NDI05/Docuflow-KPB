<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#161B22" />
    <title>@ViewData["Title"] &middot; Docuflow KPB</title>

    <link rel="icon" href="~/images/brand/logo-kpb.png" />

    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=supreme@@400,500,700,800&display=swap" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/kpb.css" asp-append-version="true" />

    @await RenderSectionAsync("Head", required: false)
</head>

<body>
@{
    var nama = Context.Session.GetString("Nama");
    var role = Context.Session.GetString("Role");
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var initial = string.IsNullOrWhiteSpace(nama) ? "?" : nama.Trim().Substring(0, 1).ToUpperInvariant();
}

<div class="kpb-shell">

    <aside class="kpb-sidebar">

        <div class="kpb-brand">
            <img src="~/images/brand/logo-kpb.png" alt="PT Kilang Pertamina Balikpapan" />

            <div class="kpb-brand-app">
                <div class="kpb-mark on-dark" aria-hidden="true"><span></span><span></span><span></span></div>
                <div>
                    <div class="kpb-brand-name">Docuflow</div>
                    <div class="kpb-brand-sub">Information Technology</div>
                </div>
            </div>
        </div>

        <nav class="kpb-nav">
            <div class="kpb-nav-label">Menu</div>

            <a asp-controller="Home" asp-action="Index" class="@(controller == "Home" ? "active" : "")">
                <i class="bi bi-grid-1x2-fill"></i>
                Beranda
            </a>

            <a asp-controller="Surat" asp-action="Index" class="@(controller == "Surat" ? "active" : "")">
                <i class="bi bi-file-earmark-text-fill"></i>
                Daftar Surat
            </a>

            @if (role == "Admin")
            {
                <a asp-controller="Users" asp-action="Index" class="@(controller == "Users" ? "active" : "")">
                    <i class="bi bi-people-fill"></i>
                    Data Users
                </a>
            }
        </nav>

        <div class="kpb-nav-foot">
            <a asp-controller="Account" asp-action="Logout">
                <i class="bi bi-box-arrow-left"></i>
                Keluar
            </a>
        </div>
    </aside>

    <div class="kpb-main">

        <header class="kpb-topbar">
            <div class="kpb-breadcrumb">@ViewData["Title"]</div>

            <div class="kpb-user">
                <div>
                    <div class="kpb-user-name">@(nama ?? "Pengguna")</div>
                    <div class="kpb-user-role">@(role ?? "-")</div>
                </div>
                <div class="kpb-avatar" aria-hidden="true">@initial</div>
            </div>
        </header>

        <main class="kpb-content">
            @RenderBody()
        </main>

        <footer class="kpb-footer">
            <div class="kpb-mark" aria-hidden="true"><span></span><span></span><span></span></div>
            <span>PT Kilang Pertamina Balikpapan &middot; Information Technology &middot; 2026</span>
        </footer>

    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
