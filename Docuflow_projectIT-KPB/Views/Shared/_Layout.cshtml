@{
    var nama = Context.Session.GetString("Nama");
    var role = Context.Session.GetString("Role");

    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    string aktif(string c) => ctrl == c ? "rail__link is-active" : "rail__link";

    var judul   = ViewData["Title"]?.ToString();
    var eyebrow = ViewData["Eyebrow"]?.ToString();
    var sub     = ViewData["Sub"]?.ToString();
}
<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@judul · IT KPB</title>

    @* Aset lokal, bukan CDN: aplikasi ini jalan di jaringan internal kilang
       dan tidak boleh bergantung pada akses internet keluar. *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/docuflow.css" asp-append-version="true" />
</head>
<body>

<div class="app">

    <nav class="rail" aria-label="Menu utama">

        @* Hanya logo. Teks pendamping dihapus — logonya sendiri sudah memuat
           "KILANG PERTAMINA BALIKPAPAN", dan menu di bawahnya sudah menyebut
           isi sistemnya. *@
        @* kpb-logo-mark.png: sudah dipotong sampai batas isi dan latar putihnya
           transparan. Berkas kpb-logo.png yang lama membawa ~1550px ruang
           kosong di kiri-kanan, sehingga logonya tampak kecil berapa pun
           tingginya disetel. *@
        <div class="rail__brand">
            <img src="~/images/kpb-logo-mark.png" alt="Kilang Pertamina Balikpapan" />
        </div>

        @* Menu mengikuti peran: berita acara untuk Admin dan Super Admin,
           kelola akun hanya untuk Super Admin. Yang disembunyikan di sini
           juga ditolak di route lewat [SessionAuthorize] — menu yang hilang
           saja bukan pengamanan. *@
        <div class="rail__nav">
            <div class="rail__label">Kerja harian</div>

            <a class="@aktif("Home")" asp-controller="Home" asp-action="Index">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z"/>
                </svg>
                Beranda
            </a>

            @if (role == "Admin" || role == "SuperAdmin")
            {
                <a class="@aktif("Surat")" asp-controller="Surat" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                        <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/>
                        <path d="M14 3v5h5M9 13h6M9 17h4"/>
                    </svg>
                    Berita Acara
                </a>
            }

            @if (role == "SuperAdmin")
            {
                <div class="rail__label">Administrasi</div>
                <a class="@aktif("Users")" asp-controller="Users" asp-action="Index">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                        <circle cx="9" cy="8" r="3.2"/>
                        <path d="M3.5 20a5.5 5.5 0 0 1 11 0M16 11.2a3 3 0 0 0 0-6M17.5 20a5.4 5.4 0 0 0-2-4.2"/>
                    </svg>
                    Pengguna
                </a>
            }
        </div>

        @* Identitas yang sedang masuk duduk di kaki rail, tepat di atas
           Keluar — dua hal itu memang satu urusan: siapa ini, dan cara
           berhenti jadi dia. *@
        <div class="rail__foot">
            <div class="rail__user">
                <span class="rail__user-nama">@(nama ?? "Pengguna")</span>
                <span class="rail__user-peran">@(role == "SuperAdmin" ? "Super Admin" : (role ?? "-"))</span>
            </div>

            <a class="rail__link" asp-controller="Account" asp-action="Logout">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                    <path d="M15 17l5-5-5-5M20 12H9M12 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h6"/>
                </svg>
                Keluar
            </a>
        </div>
    </nav>

    <div class="canvas">

        @* Tidak ada bar atas. Navigasi sudah seluruhnya di rail kiri, jadi
           judul halaman ikut mengalir di dalam isi — bukan di dalam chrome
           terpisah yang hanya mengulang apa yang sudah ditandai menu aktif. *@
        <main class="main">
            <div class="pagetitle">
                @if (!string.IsNullOrEmpty(eyebrow))
                {
                    <div class="pagetitle__eyebrow">@eyebrow</div>
                }
                <h1>@judul</h1>
                @if (!string.IsNullOrEmpty(sub))
                {
                    <p class="pagetitle__sub">@sub</p>
                }
            </div>

            @if (TempData["Message"] != null)
            {
                <div class="note note--ok">@TempData["Message"]</div>
            }
            @if (TempData["Error"] != null)
            {
                <div class="note note--danger">@TempData["Error"]</div>
            }

            @RenderBody()
        </main>

        <footer class="foot">
            Fungsi IT · Kilang Pertamina Balikpapan · @DateTime.Now.Year
        </footer>

    </div>
</div>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
