@model Docuflow_projectIT_KPB.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Docuflow</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
            body {
                margin: 0;
                padding: 0;
                font-family: Arial, Helvetica, sans-serif;
                background: #2f2f2f;
                height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
            }

            .login-wrapper {
                width: 95%;
                max-width: 1300px;
                height: 700px;
                background: white;
                border-radius: 25px;
                overflow: hidden;
                display: flex;
                box-shadow: 0px 20px 50px rgba(0,0,0,0.45);
                border: 4px solid white;
            }

            /* ================= LEFT SIDE ================= */
            .login-left {
                flex: 1.2;
                background: #2e33b8;
                position: relative;
                overflow: hidden;
                display: flex;
                justify-content: center;
                align-items: center;
            }

                /* stars */
                .login-left::before {
                    content: "";
                    position: absolute;
                    inset: 0;
                    background-image: radial-gradient(#ffffff55 1px, transparent 1px);
                    background-size: 70px 70px;
                    opacity: 0.3;
                }

            /* shooting lines */
            .shooting {
                position: absolute;
                width: 100px;
                height: 3px;
                background: white;
                opacity: 0.7;
                transform: rotate(-20deg);
                top: 80px;
                left: 170px;
                border-radius: 10px;
            }

                .shooting.two {
                    width: 70px;
                    opacity: 0.5;
                    top: 160px;
                    left: 310px;
                }

                .shooting.three {
                    width: 90px;
                    opacity: 0.5;
                    top: 120px;
                    left: 480px;
                    transform: rotate(20deg);
                    background: #ffb703;
                }

            /* planets */
            .planet {
                position: absolute;
                width: 120px;
                height: 120px;
                border-radius: 50%;
                background: linear-gradient(135deg, #ffb703, #fb5607, #8338ec);
                opacity: 0.85;
                bottom: 120px;
                right: 100px;
                box-shadow: 0px 0px 25px rgba(255, 183, 3, 0.4);
            }

                .planet.small {
                    width: 55px;
                    height: 55px;
                    bottom: 90px;
                    left: 100px;
                    opacity: 0.7;
                }

                .planet.tiny {
                    width: 30px;
                    height: 30px;
                    top: 130px;
                    right: 240px;
                    opacity: 0.7;
                }

                .planet.bottom {
                    width: 65px;
                    height: 65px;
                    bottom: 40px;
                    left: 70px;
                    opacity: 0.6;
                }

            /* ================= BRAND BOX ================= */
            .brand-container {
                position: relative;
                z-index: 2;
                width: 85%;
                max-width: 650px;
                text-align: center;
            }

            .brand-box {
                width: 100%;
                background: #e6e7ef;
                border-radius: 60px;
                padding: 18px 35px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 30px;
            }

            .brand-left {
                display: flex;
                align-items: center;
                gap: 15px;
            }

                .brand-left img {
                    width: 90px;
                    height: auto;
                }

            .brand-text {
                text-align: left;
                line-height: 1.1;
            }

                .brand-text .title {
                    font-size: 20px;
                    font-weight: 900;
                    color: #111;
                }

                .brand-text .sub {
                    font-size: 13px;
                    font-weight: 800;
                    color: #6fa8ff;
                    margin-top: 3px;
                }

            .brand-badge {
                background: #e60000;
                color: white;
                font-weight: 900;
                padding: 18px 30px;
                border-radius: 18px;
                font-size: 20px;
                line-height: 1.2;
                text-align: center;
                min-width: 240px;
            }

            /* ================= FOOTER TEXT ================= */
            .brand-footer {
                margin-top: 40px;
                font-size: 13px;
                font-weight: 700;
                color: #bfc2ff;
                letter-spacing: 0.5px;
            }

                .brand-footer .tagline {
                    margin-top: 10px;
                    font-size: 20px;
                    font-weight: 900;
                    font-style: italic;
                    color: #ff4d87;
                    letter-spacing: 1px;
                }

            /* ================= RIGHT SIDE ================= */
            .login-right {
                flex: 1;
                background: white;
                display: flex;
                justify-content: center;
                align-items: center;
            }

            .login-form-box {
                width: 100%;
                max-width: 350px;
                text-align: left;
            }

            .login-title {
                font-size: 22px;
                font-weight: 800;
                color: #444;
                text-align: center;
            }

            .login-subtitle {
                font-size: 12px;
                color: #777;
                margin-top: 5px;
                margin-bottom: 30px;
                text-align: center;
            }

            .form-label {
                font-size: 11px;
                font-weight: 700;
                color: #666;
            }

            .form-control {
                height: 35px;
                border-radius: 5px;
                border: 1px solid #ddd;
                font-size: 12px;
            }

            .btn-login {
                width: 100%;
                height: 35px;
                border-radius: 3px;
                font-weight: 700;
                background: #2e33b8;
                border: none;
                font-size: 12px;
                margin-top: 10px;
            }

                .btn-login:hover {
                    background: #23279e;
                }

            /* ================= RESPONSIVE ================= */
            @@media(max-width: 992px) {
                .login-wrapper {
                    flex-direction: column;
                    height: auto;
                }

                .login-left {
                    height: 400px;
                }

                .login-right {
                    padding: 40px 20px;
                }
            }

    </style>
</head>

<body>

    <div class="login-wrapper">

        <!-- LEFT SIDE -->
        <div class="login-left">

            <div class="shooting"></div>
            <div class="shooting two"></div>
            <div class="shooting three"></div>

            <div class="planet"></div>
            <div class="planet small"></div>
            <div class="planet tiny"></div>
            <div class="planet bottom"></div>

            <div class="brand-container"> 

                <div class="brand-box">

                    <div class="brand-left">
                        <img src="/images/Logo3.png" alt="Logo Pertamina" />
                        <div class="brand-text">
                            <div class="title">PERTAMINA</div>
                            <div class="sub">
                                KILANG PERTAMINA<br />
                                BALIKPAPAN
                            </div>
                        </div>
                    </div>

                    <div class="brand-badge">
                        INFORMATION<br />
                        TECHNOLOGY
                    </div>

                </div>

                <div class="brand-footer">
                    INFORMATION TECHNOLOGY - PT KILANG PERTAMINA BALIKPAPAN
                    <div class="tagline">ENERGIZING YOUR JOURNEY</div>
                </div>

            </div>

        </div>

        <!-- RIGHT SIDE -->
        <div class="login-right"> 

            <div class="login-form-box">

                <div class="login-title">Login to your Account</div>
                <div class="login-subtitle">Silahkan login untuk masuk ke Docuflow</div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">
                        @ViewBag.Error
                    </div>
                }

                <form asp-controller="Account" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label">Username</label>
                        <input asp-for="Username" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input asp-for="Password" type="password" class="form-control" required />
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="rememberMe">
                        <label class="form-check-label" for="rememberMe" style="font-size:11px; color:#777;">
                            Remember Me
                        </label>
                    </div>

                    <button type="submit" class="btn btn-primary btn-login">
                        Login
                    </button>
                </form>

            </div>

        </div>

    </div>

</body>
</html>