@model Docuflow_projectIT_KPB.Models.LoginViewModel

@{
    ViewData["Title"] = "Masuk";
    Layout = null;
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Masuk · IT KPB</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/docuflow.css" asp-append-version="true" />
    @* Favicon Docuflow. DUA gambar, bukan satu diperkecil - dan pembagiannya
       bukan selera:

         ukuran kecil (favicon)  mark Pertamina langsung di atas plat putih
         ukuran besar (pintasan) mark Pertamina di dalam kertas putih membulat

       Pada 16 piksel, kertas bersarang menyisakan mark selebar enam piksel,
       dan dua celah putih di antara jajar genjangnya lenyap lebih dulu -
       hasilnya bercak warna, bukan logo. Diukur pada raster 16px sungguhan,
       bukan diperkirakan dari render vektor.

       Url.Content, bukan "/favicon.ico": di bawah /docflow path berawalan
       garis miring menunjuk ke luar aplikasi dan ikonnya tidak pernah termuat. *@
    <link rel="icon" href="@Url.Content("~/favicon.ico")" sizes="any" />
    <link rel="icon" type="image/png" sizes="32x32" href="@Url.Content("~/favicon-32.png")" />
    <link rel="icon" type="image/png" sizes="16x16" href="@Url.Content("~/favicon-16.png")" />
    <link rel="apple-touch-icon" sizes="180x180" href="@Url.Content("~/apple-touch-icon.png")" />
</head>
<body>

<div class="gate">

    @* Url.Content, bukan '/images/...': aplikasi berjalan di bawah /docflow. *@
    <aside class="gate__aside" style="background-image:url('@Url.Content("~/images/gate-bg.jpg")')">
        <p class="gate__claim">Satu berita acara.<br />Satu nomor.<br /><em>Tercatat.</em></p>
        <p class="gate__meta">Fungsi IT · Kilang Pertamina Balikpapan</p>
    </aside>

    <main class="gate__form">
        <div class="gate__inner">

            <img class="gate__logo" src="~/images/kpb-logo-mark.png" alt="Kilang Pertamina Balikpapan" />

            <div class="eyebrow mb-3">Fungsi IT</div>
            <h1 class="mb-1">Masuk</h1>
            <p class="text-secondary mb-4" style="font-size:13px;">
                Akun dibuatkan oleh Admin fungsi IT.
            </p>

            @if (ViewBag.Error != null)
            {
                <div class="note note--danger" role="alert">@ViewBag.Error</div>
            }

            <form asp-controller="Account" asp-action="Login" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label class="form-label" asp-for="Username">Username</label>
                    <input asp-for="Username" class="form-control" autocomplete="username" autofocus required />
                </div>

                <div class="mb-4">
                    <label class="form-label" asp-for="Password">Kata sandi</label>
                    <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" required />
                </div>

                <button type="submit" class="btn btn-primary w-100">Masuk</button>
            </form>

        </div>

        @* Di halaman masuk juga, bukan hanya di dalam aplikasi: saat memasang,
           tim IT perlu memastikan versi yang terpasang sebelum punya akun. *@
        <div class="auth__versi"><partial name="_Version" /></div>
    </main>

</div>

</body>
</html>
