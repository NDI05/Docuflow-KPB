@model Docuflow_projectIT_KPB.Models.LoginViewModel

@{
    ViewData["Title"] = "Masuk";
    Layout = null;
}

<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#161B22" />
    <title>Masuk &middot; Docuflow KPB</title>

    <link rel="icon" href="~/images/brand/logo-kpb.png" />

    <link rel="preconnect" href="https://api.fontshare.com" crossorigin />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=supreme@@400,500,700,800&display=swap" />

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/kpb.css" asp-append-version="true" />
</head>

<body>

    <div class="kpb-login">

        <section class="kpb-login-visual">

            <div class="kpb-login-logo">
                <img src="~/images/brand/logo-kpb.png" alt="PT Kilang Pertamina Balikpapan" />
            </div>

            <div class="kpb-login-copy">
                <div class="kpb-mark on-dark" aria-hidden="true"><span></span><span></span><span></span></div>
                <h1>Satu alur untuk surat kilang.</h1>
                <p>
                    Buat berita acara, ambil nomor surat, dan arsipkan serah terima
                    perangkat IT tanpa keluar dari satu halaman.
                </p>
            </div>

            <div class="kpb-login-foot">
                Information Technology &mdash; PT Kilang Pertamina Balikpapan
            </div>

        </section>

        <section class="kpb-login-form">

            <div class="kpb-login-box">

                <div class="kpb-mark" aria-hidden="true"><span></span><span></span><span></span></div>

                <h2>Masuk ke Docuflow</h2>
                <p class="kpb-login-sub">Gunakan akun yang diberikan oleh IT KPB.</p>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger" role="alert">
                        @ViewBag.Error
                    </div>
                }

                <form asp-controller="Account" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label" asp-for="Username">Username</label>
                        <input asp-for="Username" class="form-control" autocomplete="username" autofocus required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label" asp-for="Password">Kata Sandi</label>
                        <input asp-for="Password" type="password" class="form-control" autocomplete="current-password" required />
                    </div>

                    <button type="submit" class="btn btn-danger kpb-login-submit">
                        Masuk
                    </button>
                </form>

            </div>

        </section>

    </div>

</body>
</html>
