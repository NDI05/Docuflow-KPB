@model Docuflow_projectIT_KPB.Models.LoginViewModel

@{
    ViewData["Title"] = "Login";
    Layout = null; // supaya full screen
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Docuflow</title>

    <!-- Bootstrap -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
            body {
                margin: 0;
                padding: 0;
                font-family: Arial, Helvetica, sans-serif;
                background: #eaeaea;
                height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
            }

            .login-wrapper {
                width: 95%;
                max-width: 1200px;
                height: 650px;
                background: white;
                border-radius: 20px;
                overflow: hidden;
                box-shadow: 0px 15px 35px rgba(0,0,0,0.25);
                display: flex;
            }

            /* LEFT SIDE */
            .login-left {
                flex: 1.2;
                background: #2e33b8;
                position: relative;
                padding: 50px;
                display: flex;
                justify-content: center;
                align-items: center;
                overflow: hidden;
            }

                /* decorative stars */
                .login-left::before {
                    content: "";
                    position: absolute;
                    inset: 0;
                    background-image: radial-gradient(#ffffff55 1px, transparent 1px);
                    background-size: 70px 70px;
                    opacity: 0.25;
                }

            /* decorative planet */
            .planet {
                position: absolute;
                width: 110px;
                height: 110px;
                border-radius: 50%;
                background: linear-gradient(135deg, #ffb703, #fb5607);
                opacity: 0.8;
                bottom: 90px;
                right: 70px;
                box-shadow: 0px 0px 25px rgba(255, 183, 3, 0.4);
            }

                .planet.small {
                    width: 50px;
                    height: 50px;
                    bottom: 60px;
                    left: 70px;
                    opacity: 0.6;
                }

                .planet.tiny {
                    width: 25px;
                    height: 25px;
                    top: 90px;
                    right: 140px;
                    opacity: 0.5;
                }

            /* shooting lines */
            .shooting {
                position: absolute;
                width: 70px;
                height: 2px;
                background: white;
                opacity: 0.6;
                transform: rotate(-20deg);
                top: 100px;
                left: 130px;
            }

                .shooting.two {
                    top: 180px;
                    left: 240px;
                    width: 50px;
                    opacity: 0.4;
                }

            /* Logo Card */
            .brand-box {
                position: relative;
                z-index: 2;
                width: 90%;
                max-width: 520px;
                background: rgba(255,255,255,0.15);
                border-radius: 18px;
                padding: 18px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                backdrop-filter: blur(8px);
            }

            .brand-logo {
                display: flex;
                align-items: center;
                gap: 12px;
            }

                .brand-logo img {
                    width: 60px;
                    height: auto;
                }

            .brand-text {
                color: white;
                font-size: 12px;
                font-weight: 700;
                line-height: 1.2;
            }

            .brand-badge {
                background: red;
                color: white;
                font-weight: 800;
                padding: 10px 18px;
                border-radius: 10px;
                font-size: 14px;
                text-align: center;
            }

            .brand-footer {
                position: absolute;
                bottom: 140px;
                width: 100%;
                left: 0;
                text-align: center;
                color: white;
                font-size: 12px;
                font-weight: 600;
                opacity: 0.9;
                z-index: 2;
            }

                .brand-footer .tagline {
                    margin-top: 6px;
                    font-size: 16px;
                    font-weight: 800;
                    color: #ff5c8a;
                    font-style: italic;
                    letter-spacing: 1px;
                }

            /* RIGHT SIDE */
            .login-right {
                flex: 1;
                background: white;
                padding: 80px 60px;
                display: flex;
                justify-content: center;
                align-items: center;
            }

            .login-form-box {
                width: 100%;
                max-width: 350px;
            }

            .login-title {
                font-size: 22px;
                font-weight: 800;
                color: #333;
                margin-bottom: 5px;
            }

            .login-subtitle {
                font-size: 13px;
                color: #777;
                margin-bottom: 30px;
            }

            .form-label {
                font-size: 12px;
                font-weight: 700;
                color: #555;
            }

            .form-control {
                height: 42px;
                border-radius: 10px;
                border: 1px solid #ddd;
                font-size: 14px;
            }

                .form-control:focus {
                    border-color: #2e33b8;
                    box-shadow: 0px 0px 0px 3px rgba(46, 51, 184, 0.2);
                }

            .btn-login {
                width: 100%;
                height: 42px;
                border-radius: 10px;
                font-weight: 700;
                background: #2e33b8;
                border: none;
                transition: 0.2s;
            }

                .btn-login:hover {
                    background: #23279e;
                }

            /* responsive */
            @@media(max-width: 992px) {
                .login-wrapper {
                    flex-direction: column;
                    height: auto;
                }

                .login-left {
                    padding: 40px 20px;
                    min-height: 330px;
                }

                .login-right {
                    padding: 50px 25px;
                }

                .brand-footer {
                    bottom: 50px;
                }
            }
    </style>
</head>

<body>

    <div class="login-wrapper">

        <!-- LEFT SIDE -->
        <div class="login-left">

            <div class="shooting"></div>
            <div class="shooting two"></div>

            <div class="planet"></div>
            <div class="planet small"></div>
            <div class="planet tiny"></div>

            <div class="brand-box">
                <div class="brand-logo">
                    <!-- GANTI LOGO LU DISINI -->
                    <img src="/images/Logo_pertamina.png" alt="Logo" />
                    <div class="brand-text">
                        PERTAMINA<br />
                        KILANG PERTAMINA<br />
                        BALIKPAPAN
                    </div>
                </div>

                <div class="brand-badge">
                    INFORMATION<br />TECHNOLOGY
                </div>
            </div>

            <div class="brand-footer">
                INFORMATION TECHNOLOGY - PT KILANG PERTAMINA BALIKPAPAN
                <div class="tagline">ENERGIZING YOUR JOURNEY</div>
            </div>

        </div>

        <!-- RIGHT SIDE -->
        <div class="login-right">

            <div class="login-form-box">

                <div class="login-title">Login to your Account</div>
                <div class="login-subtitle">Silahkan login untuk masuk ke Docuflow</div>

                @if (ViewBag.Error != null)
                {
                    <div class="alert alert-danger">
                        @ViewBag.Error
                    </div>
                }

                <form asp-controller="Account" asp-action="Login" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-3">
                        <label class="form-label">Username</label>
                        <input asp-for="Username" class="form-control" placeholder="Masukkan username" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Password</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Masukkan password" required />
                    </div>

                    <button type="submit" class="btn btn-primary btn-login">
                        Login
                    </button>
                </form>

            </div>

        </div>

    </div>

</body>
</html>