@model Docuflow_projectIT_KPB.Models.User

@{
    ViewData["Title"] = "Atur ulang kata sandi";
    ViewData["Eyebrow"] = "Administrasi";
    ViewData["Sub"] = $"Untuk akun {Model.Nama} ({Model.Username}).";
}

<div class="row">
    <div class="col-lg-6 col-xl-5">
        <div class="panel">
            <form asp-action="ResetPassword" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />

                <div class="panel__body">
                    <div class="note">
                        Sandi lama tidak bisa dipulihkan setelah diganti. Sampaikan sandi baru
                        langsung ke pemilik akun, lalu minta ia menggantinya.
                    </div>

                    <div class="mb-3">
                        <label class="form-label" for="newPassword">Kata sandi baru</label>
                        <input type="password" id="newPassword" name="newPassword"
                               class="form-control" autocomplete="new-password"
                               minlength="6" required autofocus />
                        <div class="fieldset__hint">Minimal 6 karakter.</div>
                    </div>

                    <div class="mb-0">
                        <label class="form-label" for="confirmPassword">Ulangi kata sandi baru</label>
                        <input type="password" id="confirmPassword" name="confirmPassword"
                               class="form-control" autocomplete="new-password"
                               minlength="6" required />
                    </div>
                </div>

                <div class="panel__head" style="border-top:1px solid var(--rule); border-bottom:0;">
                    <a class="btn btn-outline-secondary" asp-action="Index">Batal</a>
                    <button type="submit" class="btn btn-primary">Simpan sandi baru</button>
                </div>

            </form>
        </div>
    </div>
</div>
