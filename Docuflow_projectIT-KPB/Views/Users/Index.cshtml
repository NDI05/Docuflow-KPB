@model List<Docuflow_projectIT_KPB.Models.User>

@{
    ViewData["Title"] = "Data Users";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string search = ViewBag.Search ?? "";
}

<style>
    .page-card {
        border-radius: 18px;
        overflow: hidden;
        border: none;
        box-shadow: 0px 10px 25px rgba(0,0,0,0.10);
    }

    .page-header {
        background: #c6c8d9;
        padding: 14px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .page-header h5 {
            margin: 0;
            font-weight: 800;
            color: #111827;
        }

    .search-box {
        width: 220px;
        border-radius: 12px;
        font-size: 13px;
    }

    .btn-mini {
        border-radius: 10px;
        font-weight: 700;
        font-size: 13px;
        padding: 7px 12px;
    }

    .table-custom {
        background: white;
        border-radius: 14px;
        overflow: hidden;
    }

        .table-custom thead {
            background: #c6c8d9;
            font-weight: 800;
            text-align: center;
        }

        .table-custom tbody td {
            vertical-align: middle;
            font-size: 13px;
        }

    .pagination .page-link {
        border-radius: 10px;
        margin: 0 3px;
        font-weight: 700;
        color: #0d1a8a;
    }

    .pagination .active .page-link {
        background: #0d1a8a;
        border-color: #0d1a8a;
        color: white;
    }
</style>

<div class="card page-card">

    <div class="page-header">
        <h5>Data Users</h5>

        <div class="d-flex gap-2 align-items-center">

            <form method="get" asp-action="Index" class="d-flex gap-2">
                <input type="text"
                       name="search"
                       value="@search"
                       class="form-control form-control-sm search-box"
                       placeholder="Search" />

                <button type="submit" class="btn btn-primary btn-mini">
                    Cari
                </button>
            </form>

            <a asp-action="Create" class="btn btn-primary btn-mini">
                Tambah Users +
            </a>

        </div>
    </div>

    <div class="card-body" style="background:#f4f6fb;">

        <!-- ALERT ERROR -->
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <!-- ALERT SUCCESS -->
        @if (TempData["Message"] != null)
        {
            <div class="alert alert-success">
                @TempData["Message"]
            </div>
        }

        <div class="table-responsive table-custom">
            <table class="table table-bordered table-hover mb-0">

                <thead>
                    <tr>
                        <th width="60">No.</th>
                        <th width="150">ID Badge</th>
                        <th>Nama</th>
                        <th width="120">Role</th>
                        <th>Username</th>
                        <th width="200">Aksi</th>
                    </tr>
                </thead>

                <tbody>
                    @{
                        int no = ((currentPage - 1) * 15) + 1;
                    }

                    @if (Model != null && Model.Any())
                    {
                        foreach (var user in Model)
                        {
                            <tr>
                                <td class="text-center">@no</td>
                                <td class="text-center">@user.NomorPegawai</td>

                                <td style="font-weight:700;">
                                    @user.Nama
                                </td>

                                <td class="text-center">
                                    <span class="badge bg-secondary">@user.Role</span>
                                </td>

                                <td class="text-center">
                                    @user.Username
                                </td>

                                <td class="text-center">

                                    <a asp-action="ResetPassword"
                                           asp-route-id="@user.Id"
                                           class="btn btn-sm btn-primary btn-mini">
                                        Reset
                                    </a>

                                    <form asp-action="Delete"
                                          method="post"
                                          style="display:inline"
                                          onsubmit="return confirm('Yakin hapus user ini?');">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="id" value="@user.Id" />

                                        <button type="submit"
                                                class="btn btn-danger btn-sm btn-mini">
                                            Delete
                                        </button>
                                    </form>

                                </td>
                            </tr>

                            no++;
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">
                                Belum ada data user
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>

        <!-- PAGINATION -->
        <div class="d-flex justify-content-between align-items-center mt-3">
            <div class="text-muted" style="font-size:14px;">
                Page <b>@currentPage</b> of <b>@totalPages</b>
            </div>

            <nav>
                <ul class="pagination mb-0">

                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link"
                               href="/Users/Index?page=@(currentPage - 1)&search=@search">
                            &laquo;
                        </a>
                    </li>

                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link"
                                   href="/Users/Index?page=@i&search=@search">
                                @i
                            </a>
                        </li>
                    }

                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link"
                               href="/Users/Index?page=@(currentPage + 1)&search=@search">
                            &raquo;
                        </a>
                    </li>

                </ul>
            </nav>
        </div>

    </div>
</div>