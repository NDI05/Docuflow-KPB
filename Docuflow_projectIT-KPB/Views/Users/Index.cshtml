@model List<Docuflow_projectIT_KPB.Models.User>

@{
    ViewData["Title"] = "Pengguna";
    ViewData["Eyebrow"] = "Administrasi";

    int halaman = ViewBag.CurrentPage ?? 1;
    int totalHalaman = ViewBag.TotalPages ?? 1;
    string cari = ViewBag.Search ?? "";

    ViewData["Sub"] = string.IsNullOrEmpty(cari)
        ? "Akun yang bisa masuk ke sistem."
        : $"Hasil pencarian untuk “{cari}”.";

    var jendela = new List<int>();
    for (int i = 1; i <= totalHalaman; i++)
    {
        if (i == 1 || i == totalHalaman || (i >= halaman - 2 && i <= halaman + 2))
        {
            jendela.Add(i);
        }
    }

    string kelasPeran(string peran) => peran switch
    {
        "SuperAdmin" => "chip chip--role chip--admin",
        "Admin"      => "chip chip--role chip--manager",
        _            => "chip chip--role"
    };

    string labelPeran(string peran) => peran == "SuperAdmin" ? "Super Admin" : peran;
}

<div class="panel">

    <div class="panel__head">
        <form method="get" asp-action="Index" class="finder" role="search">
            <input type="search" name="search" value="@cari" class="form-control"
                   placeholder="Cari nama, username, peran, atau nomor pegawai"
                   aria-label="Cari pengguna" />
            <button type="submit" class="btn btn-outline-secondary">Cari</button>
            @if (!string.IsNullOrEmpty(cari))
            {
                <a class="btn btn-outline-secondary" asp-action="Index">Bersihkan</a>
            }
        </form>

        <a class="btn btn-primary" asp-action="Create">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M12 5v14M5 12h14"/>
            </svg>
            Tambah pengguna
        </a>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="ledger--wrap">
            <table class="ledger">
                <thead>
                    <tr>
                        <th>Nama</th>
                        <th>Username</th>
                        <th>Peran</th>
                        <th>Posisi tanda tangan</th>
                        <th>Nomor pegawai</th>
                        <th>NPK</th>
                        <th><span class="visually-hidden">Aksi</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td style="font-weight:600;">@u.Nama</td>
                            <td class="serial">@u.Username</td>
                            <td><span class="@kelasPeran(u.Role)">@labelPeran(u.Role)</span></td>
                            <td>
                                @if (string.IsNullOrWhiteSpace(u.PosisiTtd))
                                {
                                    <span class="text-secondary">—</span>
                                }
                                else
                                {
                                    <span class="chip">@u.PosisiTtd</span>
                                }
                            </td>
                            <td class="serial">@(string.IsNullOrWhiteSpace(u.NomorPegawai) ? "—" : u.NomorPegawai)</td>
                            <td class="serial">@(string.IsNullOrWhiteSpace(u.Npk) ? "—" : u.Npk)</td>
                            <td>
                                <div class="d-flex gap-2 justify-content-end">
                                    <a class="btn btn-outline-secondary btn-sm"
                                       asp-action="ResetPassword" asp-route-id="@u.Id">Atur ulang sandi</a>

                                    <form asp-action="Delete" method="post" class="d-inline"
                                          onsubmit="return confirm('Hapus pengguna @u.Nama? Tindakan ini tidak bisa dibatalkan.');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@u.Id" />
                                        <button type="submit" class="btn btn-outline-secondary btn-sm text-danger">Hapus</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <div class="panel__body">
            <div class="pager">
                <span class="pager__info">Halaman @halaman dari @totalHalaman</span>

                <nav class="pager__links" aria-label="Navigasi halaman">
                    <a class="@(halaman == 1 ? "is-disabled" : "")"
                       asp-action="Index" asp-route-page="@(halaman - 1)" asp-route-search="@cari"
                       aria-label="Halaman sebelumnya">‹</a>

                    @{ int sebelumnya = 0; }
                    @foreach (var n in jendela)
                    {
                        if (sebelumnya > 0 && n - sebelumnya > 1)
                        {
                            <span class="is-disabled">…</span>
                        }

                        if (n == halaman)
                        {
                            <span class="is-current" aria-current="page">@n</span>
                        }
                        else
                        {
                            <a asp-action="Index" asp-route-page="@n" asp-route-search="@cari">@n</a>
                        }

                        sebelumnya = n;
                    }

                    <a class="@(halaman == totalHalaman ? "is-disabled" : "")"
                       asp-action="Index" asp-route-page="@(halaman + 1)" asp-route-search="@cari"
                       aria-label="Halaman berikutnya">›</a>
                </nav>
            </div>
        </div>
    }
    else
    {
        <div class="empty">
            @if (!string.IsNullOrEmpty(cari))
            {
                <h3>Tidak ada yang cocok</h3>
                <p>Tidak ada pengguna yang mengandung “@cari”.</p>
                <a class="btn btn-outline-secondary" asp-action="Index">Tampilkan semua</a>
            }
            else
            {
                <h3>Belum ada pengguna</h3>
                <p>Tambahkan akun agar staff bisa masuk dan membuat berita acara.</p>
                <a class="btn btn-primary" asp-action="Create">Tambah pengguna</a>
            }
        </div>
    }

</div>
