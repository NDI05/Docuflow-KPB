@model List<Docuflow_projectIT_KPB.Models.User>

@{
    ViewData["Title"] = "Data Users";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
    string search = ViewBag.Search ?? "";

    Func<string, string> badgeClass = r => r switch
    {
        "Admin" => "is-admin",
        "Manager" => "is-manager",
        "PenanggungJawab" => "is-pj",
        _ => "is-staff"
    };
}

<div class="kpb-head">
    <div>
        <h1>Data Users</h1>
        <p>Akun yang dapat masuk ke Docuflow.</p>
    </div>

    <div class="kpb-head-actions">
        <form method="get" asp-action="Index" class="kpb-search" role="search">
            <input type="text"
                   name="search"
                   value="@search"
                   class="form-control"
                   aria-label="Cari nama atau username"
                   placeholder="Cari nama atau username" />

            <button type="submit" class="btn btn-ghost-ink btn-sm">Cari</button>
        </form>

        <a asp-action="Create" class="btn btn-on-ink btn-sm">
            <i class="bi bi-plus-lg"></i> Tambah User
        </a>
    </div>
</div>

<div class="kpb-panel-body">

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger" role="alert">@TempData["Error"]</div>
    }

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success" role="status">@TempData["Message"]</div>
    }

    <div class="kpb-table-wrap">
        <table class="kpb-table">

            <thead>
                <tr>
                    <th style="width:60px;">No</th>
                    <th style="width:140px;">ID Badge</th>
                    <th>Nama</th>
                    <th style="width:150px;">Role</th>
                    <th style="width:180px;">Username</th>
                    <th class="is-center" style="width:230px;">Aksi</th>
                </tr>
            </thead>

            <tbody>
                @{
                    int no = ((currentPage - 1) * 15) + 1;
                }

                @if (Model != null && Model.Any())
                {
                    foreach (var user in Model)
                    {
                        <tr>
                            <td class="is-center">@no</td>
                            <td>@user.NomorPegawai</td>
                            <td class="is-key">@user.Nama</td>

                            <td>
                                <span class="kpb-badge @badgeClass(user.Role)">@user.Role</span>
                            </td>

                            <td>@user.Username</td>

                            <td>
                                <div class="kpb-actions">
                                    <a asp-action="ResetPassword"
                                       asp-route-id="@user.Id"
                                       class="btn btn-outline-ink btn-sm">
                                        Reset Sandi
                                    </a>

                                    <form asp-action="Delete"
                                          method="post"
                                          onsubmit="return confirm('Hapus user @(user.Nama)? Tindakan ini tidak bisa dibatalkan.');">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="id" value="@user.Id" />

                                        <button type="submit" class="btn btn-outline-danger btn-sm">Hapus</button>
                                    </form>
                                </div>
                            </td>
                        </tr>

                        no++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="is-empty">
                            @if (string.IsNullOrWhiteSpace(search))
                            {
                                <text>Belum ada user terdaftar.</text>
                            }
                            else
                            {
                                <text>Tidak ada user yang cocok dengan &ldquo;@search&rdquo;.</text>
                            }
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>

    <div class="kpb-pager">
        <div class="kpb-pager-count">
            Halaman <b>@currentPage</b> dari <b>@totalPages</b>
        </div>

        <nav aria-label="Navigasi halaman">
            <ul class="pagination">

                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="/Users/Index?page=@(currentPage - 1)&search=@search" aria-label="Sebelumnya">&laquo;</a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link" href="/Users/Index?page=@i&search=@search">@i</a>
                    </li>
                }

                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <a class="page-link" href="/Users/Index?page=@(currentPage + 1)&search=@search" aria-label="Berikutnya">&raquo;</a>
                </li>

            </ul>
        </nav>
    </div>

</div>
