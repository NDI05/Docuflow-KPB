@model Docuflow_projectIT_KPB.Models.User

@{
    ViewData["Title"] = "Tambah User";
}

<div class="card shadow-lg border-0" style="border-radius:18px; overflow:hidden;">

    <div class="card-header" style="background:#c6c8d9;">
        <h5 class="mb-0" style="font-weight:800;">Tambah User</h5>
    </div>

    <div class="card-body" style="background:#f4f6fb;">

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="row">

                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Nomor Pegawai</label>
                    <input asp-for="NomorPegawai" class="form-control" required />
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Nama</label>
                    <input asp-for="Nama" class="form-control" required />
                </div>

                <div class="col-md-4 mb-3">
                    <label class="form-label fw-bold">Role</label>
                    <select asp-for="Role" class="form-control" required>
                        <option value="">-- Pilih Role --</option>
                        <option value="Admin">Admin</option>
                        <option value="Staff">Staff</option>
                        <option value="Manager">Manager</option>
                    </select>
                </div>

            </div>

            <div class="row">

                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Username (untuk login)</label>
                    <input asp-for="Username" class="form-control" required />
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label fw-bold">Password</label>

                    <!-- INI WAJIB name="password" -->
                    <input type="password" name="password" class="form-control" required />
                </div>

            </div>

            <div class="text-end mt-3">
                <button type="submit" class="btn btn-success">
                    Simpan
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Kembali
                </a>
            </div>

        </form>

    </div>
</div>