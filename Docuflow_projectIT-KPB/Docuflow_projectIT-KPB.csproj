<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- net8.0, bukan net10.0. Server produksi Pertamina hanya punya ASP.NET
         Core 8 Hosting Bundle — sama seperti TrackingSystem yang sudah berjalan
         di sana. Dipublish sebagai net10.0, IIS membalas HTTP 500.31 tanpa
         pesan lain yang menjelaskan sebabnya. Versi paket EF di bawah ikut
         diturunkan ke 8.0.11, sama persis dengan TrackingSystem, supaya
         kombinasinya sudah terbukti di lingkungan itu. -->
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Docuflow_projectIT_KPB</RootNamespace>
    <!-- Versi rilis sistem. Satu-satunya tempat angkanya ditulis: badge versi di
         setiap halaman (Views/Shared/_Version.cshtml) membacanya dari assembly,
         jadi menaikkan versi = ubah baris ini lalu publish ulang.
         WAJIB dinaikkan setiap publish. Riwayatnya di documentation/CHANGELOG.md.
         Konvensi ini mengikuti TrackingSystem, sistem sebelah di kilang yang
         sama, supaya tim IT membaca versi dengan cara yang sudah mereka kenal. -->
    <Version>1.1.1</Version>
    <!-- SDK secara bawaan menempelkan SHA commit ke ProductVersion. Dimatikan:
         build produksi dijalankan di VM, dan deploy.sh sengaja TIDAK menyalin
         .git ke sana, jadi SHA yang tercap adalah commit lama sisa kloning
         pertama — penanda asal-usul yang menyesatkan pada berkas yang
         diserahkan. Versinya sendiri tetap ada dan itu yang dibaca badge. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.1.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Rotativa.AspNetCore" Version="1.4.0" />
  </ItemGroup>

</Project>
